{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quasar.dev/contracts/image-contract-v1.schema.json",
  "title": "Quasar image contract v1",
  "type": "object",
  "required": ["org.quasar.image.contract", "org.quasar.image.family", "org.quasar.image.base.version", "org.quasar.image.acceleration", "org.quasar.image.entrypoint"],
  "properties": {
    "org.quasar.image.contract": {"const": "1"},
    "org.quasar.image.family": {"const": "fedora"},
    "org.quasar.image.base.version": {"type": "string", "minLength": 1},
    "org.quasar.image.acceleration": {"enum": ["optional", "required"]},
    "org.quasar.image.graphics-apis": {"type": "string", "pattern": "^(vulkan|egl|opengl)(,(vulkan|egl|opengl))*$"},
    "org.quasar.image.entrypoint": {"const": "/usr/local/bin/quasar-entrypoint"}
  },
  "allOf": [{"if": {"properties": {"org.quasar.image.acceleration": {"const": "required"}}}, "then": {"required": ["org.quasar.image.graphics-apis"]}}],
  "additionalProperties": true
}

