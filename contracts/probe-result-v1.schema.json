{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quasar.dev/contracts/probe-result-v1.schema.json",
  "title": "Quasar GPU probe result v1",
  "type": "object",
  "required": ["contract_version", "result"],
  "properties": {
    "contract_version": {"const": 1},
    "expected_hardware_key": {"type": "string"},
    "detected": {"type": "object"},
    "software_renderer": {"type": "boolean"},
    "result": {"enum": ["pass", "fail"]},
    "reason": {"type": "string"}
  },
  "additionalProperties": false
}

