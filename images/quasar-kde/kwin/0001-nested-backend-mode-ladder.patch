+// Quasar: mode-ladder plumbing -----------------------------------------------
+//
+// A nested output has no hardware modes: upstream synthesises exactly ONE mode
+// from the host's xdg_toplevel.configure size and drops everything else, so
+// System Settings -> Display shows a one-entry resolution list and applying a
+// resolution is a no-op. The three functions below give it a real ladder taken
+// from the host compositor's wl_output, make a user-picked mode stick, and keep
+// the toplevel filling the host's area regardless (the content is scaled by
+// wp_viewport - see contentScale()).
+
+// Quasar: rungs offered in addition to whatever the host advertises.
+//
+// Reading the host's wl_output ladder is the primary source, but it is only a
+// HINT: this backend always commits a surface covering the host's configured
+// area (the content is scaled into it by contentScale()), so any size at or
+// below the configured one is presentable against ANY host - including one that
+// advertises a single mode, which is what every wlroots/mutter/kwin headless
+// parent does. Offering the standard rungs therefore costs nothing and is what
+// makes the resolution list useful instead of a one-entry no-op.
+//
+// Only rungs in the SAME aspect family as the host-configured size are offered;
+// a different aspect would letterbox the desktop for no reason.
+// Set KWIN_NESTED_EXTRA_MODES=0 to offer nothing but the host's own ladder.
+static QList<QSize> standardRungs(const QSize &nativeSize)
+{
+    static const bool disabled = qgetenv("KWIN_NESTED_EXTRA_MODES") == "0";
+    if (disabled || nativeSize.isEmpty()) {
+        return {};
+    }
+    static constexpr std::array<QSize, 20> candidates{
+        // 16:9
+        QSize(3840, 2160), QSize(2560, 1440), QSize(1920, 1080), QSize(1600, 900),
+        QSize(1366, 768), QSize(1280, 720), QSize(1024, 576), QSize(854, 480),
+        // 16:10
+        QSize(2560, 1600), QSize(1920, 1200), QSize(1680, 1050), QSize(1440, 900),
+        QSize(1280, 800), QSize(1024, 640),
+        // 21:9
+        QSize(3440, 1440), QSize(2560, 1080),
+        // 4:3
+        QSize(1600, 1200), QSize(1400, 1050), QSize(1024, 768), QSize(800, 600)};
+
+    const qreal nativeAspect = nativeSize.width() / qreal(nativeSize.height());
+    QList<QSize> rungs;
+    for (const QSize &candidate : candidates) {
+        if (candidate.width() > nativeSize.width() || candidate.height() > nativeSize.height()) {
+            continue;
+        }
+        if (candidate == nativeSize) {
+            continue;
+        }
+        const qreal aspect = candidate.width() / qreal(candidate.height());
+        if (std::abs(aspect - nativeAspect) > 0.01) {
+            continue;
+        }
+        rungs.append(candidate);
+    }
+    return rungs;
+}
+
+std::shared_ptr<OutputMode> WaylandOutput::modeFor(const QSize &size, bool preferred)
+{
+    const auto key = std::make_pair(size.width(), size.height());
+    auto it = m_modeCache.find(key);
+    if (it != m_modeCache.end() && it->second->refreshRate() == m_refreshRate
+        && bool(it->second->flags() & OutputModeline::Flag::Preferred) == preferred) {
+        return it->second;
+    }
+    OutputModeline::Flags flags;
+    if (preferred) {
+        flags |= OutputModeline::Flag::Preferred;
+    }
+    auto mode = std::make_shared<OutputMode>(OutputModeline(size, m_refreshRate, flags));
+    m_modeCache[key] = mode;
+    return mode;
+}
+
+void WaylandOutput::rebuildModes(State &next, const QSize &nativeSize, const QSize &currentSize)
+{
+    // Resolve the current size ONCE: an invalid or oversized request falls back
+    // to the native size, and everything below (including the Preferred flag)
+    // then agrees on what "current" is. Computing it twice let an invalid
+    // currentSize cache the native mode with Preferred cleared.
+    QSize cur = currentSize;
+    if (!cur.isValid() || cur.isEmpty()
+        || cur.width() > nativeSize.width() || cur.height() > nativeSize.height()) {
+        cur = nativeSize;
+    }
+
+    QList<QSize> sizes;
+    sizes.append(nativeSize);
+    if (!sizes.contains(cur)) {
+        sizes.append(cur);
+    }
+    QList<QSize> candidates = m_backend->display()->parentModeSizes();
+    candidates.append(standardRungs(nativeSize));
+    for (const QSize &candidate : std::as_const(candidates)) {
+        // Only rungs at or below the size the host configured us at: the surface
+        // must keep covering the host's area, never overflow it.
+        if (candidate.width() > nativeSize.width() || candidate.height() > nativeSize.height()) {
+            continue;
+        }
+        if (!sizes.contains(candidate)) {
+            sizes.append(candidate);
+        }
+    }
+    std::sort(sizes.begin(), sizes.end(), [](const QSize &a, const QSize &b) {
+        return a.width() * qint64(a.height()) > b.width() * qint64(b.height());
+    });
+
+    QList<std::shared_ptr<OutputMode>> modes;
+    modes.reserve(sizes.size());
+    for (const QSize &size : std::as_const(sizes)) {
+        modes.append(modeFor(size, size == nativeSize));
+    }
+    next.modes = modes;
+    next.currentMode = modeFor(cur, cur == nativeSize);
+}
+
+void WaylandOutput::refreshModeLadder()
+{
+    if (!m_nativeSize.isValid() || m_nativeSize.isEmpty()) {
+        return;
+    }
+    State next = m_state;
+    rebuildModes(next, m_nativeSize, m_userMode.value_or(m_nativeSize));
+    setState(next);
+}
+
+QSize WaylandOutput::parentLogicalSize() const
+{
+    return m_parentLogicalSize;
+}
+
+qreal WaylandOutput::contentScale() const
+{
+    const QSize pixel = pixelSize();
+    const QSize parent = m_parentLogicalSize;
+    if (pixel.isEmpty() || parent.isEmpty()) {
+        // unpatched behaviour
+        return scale() > 0 ? 1.0 / scale() : 1.0;
+    }
+    return std::min(parent.width() / qreal(pixel.width()), parent.height() / qreal(pixel.height()));
+}
+
+QPointF WaylandOutput::contentOffset() const
+{
+    const QSize pixel = pixelSize();
+    const QSize parent = m_parentLogicalSize;
+    if (pixel.isEmpty() || parent.isEmpty()) {
+        return QPointF();
+    }
+    const qreal factor = contentScale();
+    return QPointF((parent.width() - pixel.width() * factor) / 2.0,
+                   (parent.height() - pixel.height() * factor) / 2.0);
+}
+
+QPointF WaylandOutput::mapFromParent(const QPointF &parentLogicalPos) const
+{
+    const qreal divisor = contentScale() * scale();
+    if (divisor <= 0) {
+        return parentLogicalPos;
+    }
+    return (parentLogicalPos - contentOffset()) / divisor;
+}
