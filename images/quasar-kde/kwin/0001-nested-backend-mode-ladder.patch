 void WaylandDisplay::registry_global_remove(void *data, wl_registry *registry, uint32_t name)
 {
+    WaylandDisplay *display = static_cast<WaylandDisplay *>(data);
+    const auto it = std::find_if(display->m_parentOutputs.begin(), display->m_parentOutputs.end(), [name](const auto &parent) {
+        return parent->registryName == name;
