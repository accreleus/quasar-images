+}
+
+void WaylandDisplay::output_mode(void *data, wl_output *output, uint32_t flags, int32_t width, int32_t height, int32_t refresh)
+{
+    auto parent = static_cast<ParentOutput *>(data);
+    if (width <= 0 || height <= 0) {
+        return;
+    }
+    const QSize size(width, height);
+    if (!parent->pendingModes.contains(size)) {
+        parent->pendingModes.append(size);
+    }
+    if (!parent->hasDoneEvent) {
+        // wl_output v1 has no done event, so every mode event has to be committed
+        // on its own.
+        parent->modes = parent->pendingModes;
+        Q_EMIT parent->display->parentModesChanged();
+    }
+}
+
+void WaylandDisplay::output_done(void *data, wl_output *output)
+{
+    auto parent = static_cast<ParentOutput *>(data);
+    if (parent->pendingModes.isEmpty()) {
+        // An atom-less done (e.g. a scale-only update) must not wipe the ladder.
+        return;
+    }
+    if (parent->modes != parent->pendingModes) {
+        parent->modes = parent->pendingModes;
+        Q_EMIT parent->display->parentModesChanged();
+    }
+    parent->pendingModes.clear();
+}
+
+void WaylandDisplay::output_scale(void *data, wl_output *output, int32_t factor)
+{
+    // intentionally ignored; wp_fractional_scale_v1 is what drives the nested scale
+}
+
+QList<QSize> WaylandDisplay::parentModeSizes() const
+{
+    if (m_parentOutputs.empty()) {
+        return {};
+    }
+    // The nested compositor is one xdg_toplevel; it is meaningless to mix ladders
+    // from several host outputs, so the first output's ladder is the one used.
+    QList<QSize> sizes = m_parentOutputs.front()->modes;
+    std::sort(sizes.begin(), sizes.end(), [](const QSize &a, const QSize &b) {
+        return a.width() * qint64(a.height()) > b.width() * qint64(b.height());
+    });
+    sizes.erase(std::unique(sizes.begin(), sizes.end()), sizes.end());
+    return sizes;
 }
 
 }
