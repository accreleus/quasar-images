+        m_hostConfiguration = nullptr;
+    }
+    destroyHostHead();
+    if (m_hostOutputManager) {
+        zwlr_output_manager_v1_destroy(m_hostOutputManager);
+        m_hostOutputManager = nullptr;
+    }
+    m_hostOutputManagerName = 0;
+    m_hostHasSerial = false;
