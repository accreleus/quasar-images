+        releaseHostMode(mode->proxy);
+    }
+    m_hostModes.clear();
+    if (m_hostHead) {
+        if (zwlr_output_head_v1_get_version(m_hostHead) >= ZWLR_OUTPUT_HEAD_V1_RELEASE_SINCE_VERSION) {
+            zwlr_output_head_v1_release(m_hostHead);
+        } else {
