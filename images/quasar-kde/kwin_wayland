#!/usr/bin/env bash
# PATH-shadowing wrapper for /usr/bin/kwin_wayland, installed at
# /usr/local/libexec/quasar-kde/kwin_wayland and reached ONLY through the PATH
# prepend that /usr/local/bin/quasar-kde performs for the Plasma session.
#
# WHY THIS EXISTS (full rationale + the alternatives that were tried and
# rejected lives in /usr/local/bin/quasar-kde, section "Nested output sizing"):
# a nested kwin sizes its output from --width/--height, but the kwin that serves
# the Plasma session is spawned by kwin_wayland_wrapper, which forwards no size
# and offers no env knob in Plasma 6.7. kwin_wayland_wrapper invokes its
# compositor by BARE NAME, so shadowing that name is the only supported-ish way
# to get the session's real mode onto the nested output.
#
# This wrapper must stay trivial: logging env, append two flags, exec the
# real binary. It deliberately does NOT live in /usr/local/bin -- shadowing
# kwin_wayland for every process in the image would be a much wider blast radius
# than the session.
set -euo pipefail

# The nested backend's own log lines (kwin/0004: "asked the host for mode",
# "host moved to mode", the fallbacks) are qCInfo in the kwin_wayland_backend
# category, which kwin declares at warning level. Without this rule a forwarded
# display-mode pick leaves no trace in the container log, and a pick that goes
# wrong cannot be attributed to kwin or to the host. Appended, so an operator's
# own QT_LOGGING_RULES still applies. QT_FORCE_STDERR_LOGGING because Fedora's
# Qt otherwise sends a non-terminal stderr's messages to the (absent) journal;
# the launcher sets both session-wide too, this keeps kwin covered even if the
# session start-up drops them.
export QT_FORCE_STDERR_LOGGING=1
export QT_LOGGING_RULES="${QT_LOGGING_RULES:+${QT_LOGGING_RULES};}kwin_wayland_backend.info=true"

exec /usr/bin/kwin_wayland \
  --width "${QUASAR_KDE_OUTPUT_WIDTH:-1920}" \
  --height "${QUASAR_KDE_OUTPUT_HEIGHT:-1080}" \
  "$@"
