#!/usr/bin/env bash
set -euo pipefail

# --- Wayland socket handoff (quasar#379) -------------------------------------
# Identical contract to images/quasar-steam/quasar-steam lines 13-17. The
# node-agent provides XDG_RUNTIME_DIR + WAYLAND_DISPLAY for ITS compositor
# socket (a file bind at $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY, e.g.
# /run/quasar-wayland/wayland-3 -- the name varies per session). kwin needs a
# private, user-owned XDG_RUNTIME_DIR for its own nested socket (and for every
# Plasma component's lock/socket files), so this launcher repoints it below --
# but first the agent socket is resolved to an ABSOLUTE path so the repoint
# cannot orphan it.
if [[ -n "${WAYLAND_DISPLAY:-}" && "${WAYLAND_DISPLAY}" != /* ]]; then
  export WAYLAND_DISPLAY="${XDG_RUNTIME_DIR:-/run/quasar-wayland}/${WAYLAND_DISPLAY}"
fi
export XDG_RUNTIME_DIR="${QUASAR_KDE_RUNTIME_DIR:-$HOME/.runtime}"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 0700 "$XDG_RUNTIME_DIR"

log() { printf '%s quasar-kde: %s\n' "$(date -Iseconds)" "$*" >&2; }

# --- Graceful shutdown: launcher-owned sequenced relay (quasar-images#1) -----
# images/quasar-base/Dockerfile's tini does not run with -g, so `docker stop`
# SIGTERMs only this launcher (tini's direct child) -- this script owns relaying
# that shutdown to the Plasma session itself instead of `exec`ing the session
# chain away. No process-group tricks anywhere below: every process stays in
# tini's direct descendant tree, so there is no group to kill and no way to
# reproduce the quasar-steam 6551fe8 FATAL (EPERM from a group-kill against a
# reshaped process group under --cap-drop ALL / no CAP_KILL).
shutdown_timeout="${QUASAR_KDE_SHUTDOWN_TIMEOUT:-8}"
# A non-numeric override must not silently collapse the budget to a zero-wait
# escalation -- fall back to the documented default instead.
[[ "$shutdown_timeout" =~ ^[0-9]+$ ]] || shutdown_timeout=8
session_pid=""
shutting_down=0

on_term() {
  # Idempotent: a second TERM/INT while a relay is already in flight is a
  # no-op -- the first invocation owns the sequence through to completion.
  if [[ "$shutting_down" == "1" ]]; then
    return
  fi
  shutting_down=1
  log "shutdown requested; relaying to the Plasma session"

  if [[ -n "$session_pid" ]] && kill -0 "$session_pid" 2>/dev/null; then
    # A SINGLE TERM to the session process (the dbus-run-session child, which
    # has exec'd into startplasma-wayland -- dbus-run-session execs its program
    # rather than forking it, so this pid IS the session leader).
    # startplasma-wayland unwinds the session from the top: plasma_session's
    # SignalHandler closes the session, autostart apps and plasmashell go down,
    # then kwin_wayland_wrapper/kwin and Xwayland follow. Nothing below TERMs
    # plasmashell or kwin individually -- doing so races that orderly teardown,
    # the same class of unclean shutdown proven on the Steam launcher.
    log "sending SIGTERM to the Plasma session (pid $session_pid, budget ${shutdown_timeout}s)"
    kill -TERM "$session_pid" 2>/dev/null || true

    local waited=0
    local max_waited=$(( shutdown_timeout * 4 ))  # 0.25s poll ticks
    while kill -0 "$session_pid" 2>/dev/null; do
      if (( waited >= max_waited )); then
        # Deliberately NOT escalated to SIGKILL here: docker's
        # SIGKILL-after-timeout backstop reaps a wedged session, and a kill from
        # this launcher would only strand kwin's half-written config.
        log "Plasma session still running after ${shutdown_timeout}s; leaving it to the runtime backstop"
        break
      fi
      sleep 0.25 || true
      waited=$((waited + 1))
    done
  fi
}

# Installed before anything below can block or is backgrounded: no window where
# a TERM/INT could arrive and find no handler wired up.
trap on_term TERM INT

# `wait PID` returns EARLY (status >128) the instant a trapped signal is caught
# -- bash runs the trap synchronously, then hands control back to the statement
# after wait, whether or not PID has actually exited yet. Re-wait in a loop and
# only trust the exit status once `kill -0` confirms the pid is actually gone
# (that final wait's status is the real one; earlier ones are just
# signal-delivery artifacts). set -e is live, so every wait/kill here is the
# condition of an if/while -- never a bare statement -- or its nonzero would
# abort the script before we get to read $?.
wait_for_exit() {
  local pid="$1" rc=0
  while :; do
    if wait "$pid"; then rc=0; else rc=$?; fi
    if kill -0 "$pid" 2>/dev/null; then
      continue
    fi
    break
  done
  return "$rc"
}

# --- Parent compositor readiness --------------------------------------------
# Same philosophy as the Steam launcher's gamescope-ready handshake: bounded,
# never infinite, and generous enough that a healthy-but-slow parent cannot lose
# the race. kwin_wayland nested has no ready socket to read, so the observable
# precondition is the parent compositor's socket file existing.
compositor_timeout="${QUASAR_KDE_COMPOSITOR_TIMEOUT:-30}"
[[ "$compositor_timeout" =~ ^[0-9]+$ ]] || compositor_timeout=30

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
  log "FATAL: WAYLAND_DISPLAY is not set; quasar-kde runs kwin_wayland NESTED and"
  log "       requires the node-agent's parent compositor socket (XDG_RUNTIME_DIR + WAYLAND_DISPLAY)."
  exit 1
fi

compositor_waited=0
compositor_max=$(( compositor_timeout * 4 ))  # 0.25s poll ticks
while [[ ! -e "$WAYLAND_DISPLAY" ]]; do
  if [[ "$shutting_down" == "1" ]]; then
    log "shutdown requested during startup; exiting without launching Plasma"
    exit 143
  fi
  if (( compositor_waited >= compositor_max )); then
    log "FATAL: parent compositor socket '$WAYLAND_DISPLAY' did not appear within ${compositor_timeout}s"
    exit 1
  fi
  sleep 0.25 || true
  compositor_waited=$((compositor_waited + 1))
done
log "parent compositor socket ready: $WAYLAND_DISPLAY"

# --- First-run $HOME init (idempotent) --------------------------------------
# Both steps are safe to repeat on every boot, so no marker file is needed (a
# marker would also go stale against a $HOME volume restored from backup).
# xdg-user-dirs-update is idempotent by design; `flatpak remote-add
# --if-not-exists` is a no-op when flathub is already configured.
if command -v xdg-user-dirs-update >/dev/null 2>&1; then
  xdg-user-dirs-update || log "WARNING: xdg-user-dirs-update failed; \$HOME user dirs may be missing"
fi
if command -v flatpak >/dev/null 2>&1; then
  # NEVER fatal: the desktop must start with no network at all. Discover simply
  # shows no Flathub content until a later boot succeeds.
  flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
    || log "WARNING: could not add the Flathub user remote (offline?); Discover will have no Flatpak source"
fi

# --- Nested output size (quasar#384) ----------------------------------------
# Nested kwin_wayland does not adopt the parent compositor's wl_output mode --
# it sizes its windowed-mode output from --width/--height, so whatever is given
# here is the display Plasma and every app it launches see. Quasar injects the
# session's streamed mode as QUASAR_STREAM_WIDTH/HEIGHT/FPS; nothing is baked as
# ENV in the Dockerfile (a baked 1920x1080 would silently downscale every
# non-1080p session, which is the exact quasar#384 defect). QUASAR_KDE_* wins as
# an explicit per-app pin; the literals are the last resort for `docker run`.
kde_width="${QUASAR_KDE_WIDTH:-${QUASAR_STREAM_WIDTH:-1920}}"
kde_height="${QUASAR_KDE_HEIGHT:-${QUASAR_STREAM_HEIGHT:-1080}}"
# Recorded and logged for parity with the Steam launcher's mode contract, but
# NOT passed to kwin: nested kwin_wayland has no refresh-rate flag (its windowed
# output is driven by the parent compositor's frame callbacks), so the parent's
# rate is authoritative. Kept resolved here so the session's intended mode is
# visible in one place in the logs.
kde_refresh="${QUASAR_KDE_REFRESH:-${QUASAR_STREAM_FPS:-60}}"
[[ "$kde_width"  =~ ^[0-9]+$ ]] || { log "WARNING: non-numeric width override; using 1920";  kde_width=1920; }
[[ "$kde_height" =~ ^[0-9]+$ ]] || { log "WARNING: non-numeric height override; using 1080"; kde_height=1080; }

# --- Game menu + Flatpak menu entries ---------------------------------------
# The node-agent may bind-mount agent-generated .desktop entries at
# /run/quasar/share (a full XDG data dir: applications/, icons/, ...). Absent is
# the normal standalone case: no games section, no error. The user Flatpak
# exports dir is appended unconditionally so Flatpaks the user installs through
# Discover surface in Kickoff without a re-login (the dir is created by flatpak
# on first install; a non-existent entry in XDG_DATA_DIRS is simply ignored).
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
if [[ -d /run/quasar/share ]]; then
  export XDG_DATA_DIRS="${XDG_DATA_DIRS}:/run/quasar/share"
  log "game menu mount detected: /run/quasar/share added to XDG_DATA_DIRS"
fi
export XDG_DATA_DIRS="${XDG_DATA_DIRS}:${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share"

# --- Xwayland socket directory ----------------------------------------------
# /tmp/.X11-unix is created by systemd-tmpfiles on a normal host and by nothing
# at all in a container. Without it kwin_wayland_wrapper cannot bind the X11
# socket, Xwayland never starts, DISPLAY stays empty -- and the Plasma startup
# sequence then STALLS: kcminit_startup's kcm_fonts_init shells out to xrdb
# against the empty display and plasma_session sits on a 300s D-Bus budget, so
# ksmserver and plasmashell never launch and the desktop is a permanently blank
# session. Diagnosed on the dev box 2026-08-13: with the directory absent the
# session had no plasmashell after 13 minutes; with it present Xwayland :0,
# ksmserver and plasmashell were all up inside 45s. It also has to exist for the
# desktop Steam client (a plain X11 app) to have anything to connect to.
mkdir -p /tmp/.X11-unix 2>/dev/null || true
chmod 1777 /tmp/.X11-unix 2>/dev/null || true
if [[ ! -d /tmp/.X11-unix ]]; then
  log "WARNING: /tmp/.X11-unix could not be created; Xwayland (and therefore Steam) will not start"
fi

# --- Session environment -----------------------------------------------------
# WAYLAND_DISPLAY is deliberately NOT unset: kwin_wayland connects to the parent
# compositor through it as a nested client. (The Steam launcher unsets it after
# gamescope is up because gamescope hands its clients a *new* socket; here kwin
# is the client, and it needs the parent socket for the whole session lifetime.)
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export DESKTOP_SESSION=plasma

# --- Overlay (subsurface) offloading OFF: the black-stream fix ---------------
# BLOCKING BUG, live-diagnosed on the dev box 2026-08-13 under the real Quasar
# stack (RTX 5090): the session came up perfectly -- kwin 1920x1080, Xwayland,
# ksmserver, plasmashell, GPU probe pass -- but the encoded stream was BLACK
# (browser peer: LUMA mean=0.0, fps=0), and the agent logged
# "app presented its first frame after 9537 ms (app_surface_commits=3)".
#
# WHAT IS ACTUALLY HAPPENING (WAYLAND_DEBUG=1 trace of kwin's connection to the
# agent compositor -- the only way to see it; every process-level symptom is a
# red herring):
#   -> wp_single_pixel_buffer_manager_v1.create_u32_rgba_buffer(wl_buffer, 0,0,0, 0xffffffff)
#   -> wl_surface@3.attach(wl_buffer, 0, 0)          <-- ONE opaque BLACK pixel
#   -> wp_viewport.set_destination(1920, 1080)       <-- stretched to full screen
# Over the whole session kwin's root output surface saw exactly **1 attach** and
# 144 commits: after that first frame it only ever sent set_buffer_scale + frame
# + commit, i.e. NULL commits with no new buffer and no damage, forever. The
# desktop was being drawn the entire time (885 wl_surface.attach calls from
# kwin's own clients), but kwin was offloading every window to a wl_subsurface
# ("overlay") and leaving its root surface as the single-pixel black backdrop.
# The agent's gst-wayland-display compositor presents the root surface, so the
# stream is that black pixel scaled to 1080p. Frame callbacks were NOT the
# problem -- wl_callback.done arrives normally and kwin commits at ~60 Hz.
#
# KWIN_USE_OVERLAYS=0 disables that offload path, so kwin composites the whole
# scene into its own output buffer and attaches it every frame -- which is what
# a nested compositor has to do when the parent presents one surface. Measured
# immediately after, same session type: LUMA mean=122.0 sd=0.02, DECODE fps=60,
# INPUT_PROBE click_delta=3.679 (idle_delta=0.001).
#
# gamescope never hits this: it composites everything itself and self-paces, so
# it has no overlay path to take. Do NOT remove this without re-running a live
# luma check -- the failure is invisible to every in-container smoke test,
# because in-container the session looks completely healthy.
export KWIN_USE_OVERLAYS=0

# --- Nested output sizing: HOW kwin gets its size ---------------------------
# Decision + evidence, settled empirically on the dev box against the actual
# image (Plasma 6.7.4 / kwin-6.7.4-1.fc43 / plasma-workspace-6.7.4-1.fc43,
# Fedora 43). READ THIS BEFORE CHANGING THE LAUNCH LINE BELOW.
#
# Who starts kwin here:
#   `startplasma-wayland` itself contains no reference to kwin at all
#   (`grep -ac kwin /usr/bin/startplasma-wayland` == 0) -- on a normal Fedora
#   desktop the compositor is brought up by the systemd USER manager via
#   /usr/lib/systemd/user/plasma-kwin_wayland.service
#   (`ExecStart=/usr/bin/kwin_wayland_wrapper --xwayland`). There is no systemd
#   user manager in this container, so startplasma-wayland takes its "classic
#   boot" path -- and classic boot DOES start the compositor: plasma_session
#   spawns `/usr/bin/kwin_wayland_wrapper --xwayland`, which in turn spawns
#   `kwin_wayland --wayland-fd N --socket wayland-0 --xwayland`. Observed live in
#   the process tree. So `dbus-run-session -- startplasma-wayland` is the correct
#   and complete launch line; nothing else needs starting by hand.
#
# Why the size has to be injected rather than passed:
#   kwin_wayland's windowed-mode size flags are `--width/--height`
#   (`kwin_wayland --help`: "The width for windowed mode. Default width is
#   1024."), and nested-on-Wayland IS windowed mode. But the kwin that matters
#   is spawned by kwin_wayland_wrapper, which passes only its own fixed
#   arguments, and neither startplasma-wayland nor the wrapper forwards a size.
#   Plasma therefore came up at kwin's 1024x768 default. Alternatives tried and
#   rejected, with evidence:
#     (a) A KWIN_WAYLAND_* env knob for size: none exists in 6.7 -- the only
#         KWIN_* variables in kwin_wayland_wrapper are KWIN_RESTART_COUNT and
#         KWIN_WAYLAND_NO_XAUTHORITY.
#     (c) Starting kwin_wayland ourselves with the flags and running the session
#         inside it via `kwin_wayland --width W --height H --xwayland
#         --exit-with-session /usr/bin/startplasma-wayland`: this RUNS, but
#         classic boot then starts a SECOND kwin inside the first one. Measured:
#         outer kwin 1920x1080, inner (the one Plasma actually uses) 1024x768 --
#         i.e. the sizing does not reach the session and the session pays for two
#         stacked compositors. Rejected.
#   (b) is what survives: a PATH-shadowing `kwin_wayland` wrapper, shipped at
#       /usr/local/libexec/quasar-kde/kwin_wayland, which appends --width/--height
#       and execs the real /usr/bin/kwin_wayland. kwin_wayland_wrapper launches
#       its compositor by BARE NAME ("kwin_wayland"), so it resolves through this
#       PATH -- verified live: `/usr/bin/kwin_wayland --width 1600 --height 900
#       --wayland-fd 7 --socket wayland-0 --xwayland`, and `kscreen-doctor -o`
#       reported `Geometry: 0,0 1600x900` for the session's only output.
#
# LOUD NOTE: the shim is a deliberate PATH shadow of a system binary. It is
# scoped to this session's PATH (never installed into /usr/local/bin), it only
# ever appends two flags and execs the real binary, and it exists solely because
# upstream offers no other way to size a nested Plasma session. If a future
# Plasma gains a supported size mechanism, delete the shim and the PATH prepend.
export PATH="/usr/local/libexec/quasar-kde:$PATH"
export QUASAR_KDE_OUTPUT_WIDTH="$kde_width"
export QUASAR_KDE_OUTPUT_HEIGHT="$kde_height"
if [[ ! -x /usr/local/libexec/quasar-kde/kwin_wayland ]]; then
  log "WARNING: kwin sizing shim missing; the session will come up at kwin's 1024x768 default"
fi

# --- Launch ------------------------------------------------------------------
# dbus-run-session gives the whole session one session bus (there is no systemd
# --user to provide one). It EXECS its program rather than forking it, so
# session_pid below is startplasma-wayland itself and the shutdown relay TERMs
# the session leader directly.
session=(dbus-run-session -- startplasma-wayland)

# Re-check right before backgrounding: a TERM/INT could have landed anywhere in
# the first-run init / preflight above (on_term already ran -- shutting_down=1,
# and session_pid is still unset so it had nothing to relay to). Don't start a
# whole Plasma session into a shutdown that is already in flight.
if [[ "$shutting_down" == "1" ]]; then
  log "shutdown requested during startup; exiting without launching Plasma"
  exit 143
fi

log "starting Plasma session (${kde_width}x${kde_height}@${kde_refresh}, nested on $WAYLAND_DISPLAY)"
"${session[@]}" &
session_pid=$!
# A non-zero/signal exit here (e.g. 143) after an already-clean shutdown relay is
# expected docker-stop signal-exit semantics, not a failure -- intentional.
if wait_for_exit "$session_pid"; then rc=0; else rc=$?; fi
log "Plasma session exited (rc=$rc)"
exit "$rc"
