+// Quasar: forward a game's display-mode pick to the parent compositor and
+// return to the session's mode when the game is no longer in front. See
+// Backends/QuasarModeForward.hpp. Inert unless the parent speaks
+// wlr-output-management (and GAMESCOPE_QUASAR_MODE_FORWARD is not 0).
+//
+// What a game "picked" is read from the focused window:
+//   1. _QUASAR_XWAYLAND_EMU_MODE (width, height, refresh mHz), set by the
+//      patched Xwayland on every window of a client that applied a RandR or
+//      VidMode mode;
+//   2. else _XWAYLAND_RANDR_EMU_MONITOR_RECTS (x, y, width, height), the same
+//      fact from a stock Xwayland, without the refresh;
+//   3. else, for a window of a game Xwayland (not Steam's), that Xwayland's
+//      root size when Steam changed it through GAMESCOPE_XWAYLAND_MODE_CONTROL
+//      (its per-game resolution setting).
+// Nothing picked means the session's own mode (the parent's mode before any
+// forward, updated whenever the parent moves for a reason of its own).
+static bool g_bQuasarModeDirty = true;
+
+static void quasar_mode_forward_mark_dirty()
+{
+	g_bQuasarModeDirty = true;
+}
+
+struct QuasarModeWant_t
+{
+	int32_t nWidth = 0;
+	int32_t nHeight = 0;
+	int32_t nRefreshmHz = 0; // 0: unknown, keep the current refresh
+	bool bSession = true;    // no pick: the session's own mode
+
+	bool operator==( const QuasarModeWant_t &o ) const
+	{
+		return nWidth == o.nWidth && nHeight == o.nHeight && nRefreshmHz == o.nRefreshmHz && bSession == o.bSession;
+	}
+};
+
+// Each Xwayland's root size when gamescope first saw it, so a root Steam
+// resized later (GAMESCOPE_XWAYLAND_MODE_CONTROL) can be told apart.
+static std::unordered_map<xwayland_ctx_t *, std::pair<int, int>> s_QuasarInitialRootSize;
+
+static QuasarModeWant_t quasar_mode_want_for_window( steamcompmgr_win_t *w )
+{
+	QuasarModeWant_t want;
+	if ( !w || w->type != steamcompmgr_win_type_t::XWAYLAND )
+		return want;
+
+	xwayland_ctx_t *ctx = w->xwayland().ctx;
+	if ( !ctx )
+		return want;
+
+	std::vector< uint32_t > values;
+	if ( get_prop( ctx, w->xwayland().id, ctx->atoms.quasarXWaylandEmuMode, values ) && values.size() >= 3 && values[0] && values[1] )
+		return QuasarModeWant_t{ int32_t( values[0] ), int32_t( values[1] ), int32_t( values[2] ), false };
+	if ( get_prop( ctx, w->xwayland().id, ctx->atoms.xwaylandRandrEmuMonitorRects, values ) && values.size() >= 4 && values[2] && values[3] )
+		return QuasarModeWant_t{ int32_t( values[2] ), int32_t( values[3] ), 0, false };
+
+	auto iter = s_QuasarInitialRootSize.find( ctx );
+	if ( iter != s_QuasarInitialRootSize.end() && ctx->xwayland_server != wlserver_get_xwayland_server( 0 ) &&
+		 ( ctx->root_width != iter->second.first || ctx->root_height != iter->second.second ) )
+		return QuasarModeWant_t{ ctx->root_width, ctx->root_height, 0, false };
+
+	return want;
+}
+
+static void quasar_mode_forward_tick()
+{
+	using namespace gamescope;
+
+	if ( !QuasarModeForward::Active() )
+		return;
+
+	// A: keep every Xwayland's RandR listing the parent's modes.
+	{
+		gamescope_xwayland_server_t *server = NULL;
+		for (size_t i = 0; (server = wlserver_get_xwayland_server(i)); i++)
+		{
+			xwayland_ctx_t *ctx = server->ctx.get();
+			if ( !ctx )
+				continue;
+			s_QuasarInitialRootSize.try_emplace( ctx, ctx->root_width, ctx->root_height );
+			QuasarModeForward::SyncRandRModes( ctx, ctx->dpy, ctx->root, ctx->root_width, ctx->root_height );
+		}
+	}
+
+	std::optional<QuasarModeForward::HostMode> current = QuasarModeForward::GetCurrent();
+	if ( !current )
+		return;
+
+	// The session's mode: the parent's mode until we forward something, and
+	// whatever it moves to on its own (a move that is not the answer to our
+	// last request) from then on.
+	static std::optional<QuasarModeForward::HostMode> s_session;
+	static std::optional<QuasarModeForward::HostMode> s_lastSeen;
+	static std::optional<QuasarModeForward::HostMode> s_lastAsked;
+	if ( !s_lastSeen || !QuasarModeForward::SameMode( *current, *s_lastSeen ) )
+	{
+		bool bOurs = s_session && s_lastAsked && QuasarModeForward::SameMode( *current, *s_lastAsked );
+		if ( !bOurs )
+			s_session = current;
+		s_lastAsked.reset();
+		s_lastSeen = current;
+	}
+
+	// B: what the window in front wants, re-read when it or its pick changes.
+	static uint64_t s_ulFocusSeq = UINT64_MAX;
+	static QuasarModeWant_t s_want;
+	static uint64_t s_ulWantSinceMs = 0;
+	global_focus_t *pFocus = GetCurrentFocus();
+	steamcompmgr_win_t *pWindow = pFocus ? pFocus->focusWindow : nullptr;
+	uint64_t ulFocusSeq = pWindow ? pWindow->seq : 0;
+	if ( ulFocusSeq != s_ulFocusSeq )
+	{
+		s_ulFocusSeq = ulFocusSeq;
+		g_bQuasarModeDirty = true;
+	}
+	if ( g_bQuasarModeDirty )
+	{
+		g_bQuasarModeDirty = false;
+		QuasarModeWant_t want = quasar_mode_want_for_window( pWindow );
+		if ( !( want == s_want ) )
+		{
+			s_want = want;
+			s_ulWantSinceMs = get_time_in_milliseconds();
+		}
+	}
+
+	// Launches and exits flip focus and modes a few times in quick
+	// succession; only act on a want that has held for a moment.
+	static constexpr uint64_t k_ulSettleMs = 300;
+	if ( get_time_in_milliseconds() - s_ulWantSinceMs < k_ulSettleMs )
+		return;
+
+	int32_t nWidth = s_want.bSession ? s_session->nWidth : s_want.nWidth;
+	int32_t nHeight = s_want.bSession ? s_session->nHeight : s_want.nHeight;
+	int32_t nRefreshmHz = s_want.bSession ? s_session->nRefreshmHz : s_want.nRefreshmHz;
+	if ( nRefreshmHz <= 0 )
+		nRefreshmHz = s_session->nRefreshmHz;
+
+	std::optional<QuasarModeForward::HostMode> asked = QuasarModeForward::RequestMode( nWidth, nHeight, nRefreshmHz );
+	if ( asked && !QuasarModeForward::SameMode( *asked, *current ) )
+		s_lastAsked = asked;
+	// No parent mode of that size: the game stays scaled, as upstream.
+}
