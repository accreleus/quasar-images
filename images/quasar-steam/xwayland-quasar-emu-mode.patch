+         * onto the built-in mode of the same size, so its refresh survives and
+         * sizes outside the built-in table work too. */
+        mode = new_mode;
+    } else if (new_mode) {
         mode = xwl_output_find_mode(xwl_output,
                                     new_mode->mode.width,
                                     new_mode->mode.height);
