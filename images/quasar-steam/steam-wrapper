#!/usr/bin/env bash
set -euo pipefail

# Display wiring (DISPLAY export + outer-WAYLAND_DISPLAY unset) is owned by the
# quasar-steam launcher via the gamescope ready-socket handshake (GOW pattern) —
# by the time this wrapper runs, the environment is already correct.

steam_dir="$HOME/.local/share/Steam"
legacy_dir="$HOME/.steam/steam"

if [[ ! -f "$steam_dir/steam.sh" ]]; then
  mkdir -p "$steam_dir"
  tar xJf /usr/lib/steam/bootstraplinux_ubuntu12_32.tar.xz -C "$steam_dir"
fi

mkdir -p "$(dirname "$legacy_dir")"
if [[ -L "$legacy_dir" || ! -e "$legacy_dir" ]]; then
  ln -sfn "$steam_dir" "$legacy_dir"
elif [[ -d "$legacy_dir" && -z "$(ls -A "$legacy_dir")" ]]; then
  rmdir "$legacy_dir"
  ln -s "$steam_dir" "$legacy_dir"
else
  printf '%s\n' "quasar-steam: refusing to replace non-empty $legacy_dir" >&2
fi

# Steam's idle screensaver blanks the stream after ~5 minutes with no input
# (accreleus/quasar#819). Steam keeps its timeout in config/config.vdf, under
# InstallConfigStore/Software/Valve/Steam/system; 0 is "Disabled" in its own
# settings. Set it only when the key is absent, so a choice made in Steam sticks,
# and edit the file before Steam starts, as Steam rewrites it from memory.
#
# A cosmetic setting must never stop Steam from starting: the function runs as an
# `if` condition (errexit is off inside it, so every step ends in `|| return 1`),
# and a failure is one warning, then the launch goes on. The file is replaced by a
# rename of a temp file in the same directory, so a kill never leaves it half-written.
set_idle_screensaver() {
  local key=IdleScreensaverACSeconds dir="$steam_dir/config" tmp rc
  local cfg="$dir/config.vdf"
  mkdir -p "$dir" || return 1
  tmp="$(mktemp "$dir/.config.vdf.XXXXXX")" || return 1
  if [[ ! -s "$cfg" ]]; then
    chmod 0644 "$tmp" || { rm -f "$tmp"; return 1; }
    printf '"InstallConfigStore"\n{\n\t"Software"\n\t{\n\t\t"Valve"\n\t\t{\n\t\t\t"Steam"\n\t\t\t{\n\t\t\t\t"system"\n\t\t\t\t{\n\t\t\t\t\t"%s"\t\t"0"\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n' \
      "$key" > "$tmp" || { rm -f "$tmp"; return 1; }
  elif grep -qi "\"$key\"" "$cfg"; then
    rm -f "$tmp"
    return 0
  else
    # Insert into the Steam block's "system" block, creating that block if it is
    # missing; a CRLF file keeps its line endings. No Steam block (not a config
    # Steam wrote): exit 3, the file is left alone.
    chmod --reference="$cfg" "$tmp" || { rm -f "$tmp"; return 1; }
    awk -v key="$key" '
      { l[NR] = $0 }
      END {
        for (i = 1; i <= NR; i++) {
          s = l[i]; gsub(/^[ \t]+|[ \t]+$/, "", s); sub(/\r$/, "", s)
          if (s == "{") { d++; p[d] = (d > 1 ? p[d - 1] "/" : "") tolower(name)
            if (p[d] == "installconfigstore/software/valve/steam") steam = i
            if (p[d] == "installconfigstore/software/valve/steam/system") sys = i
          } else if (s == "}") d--
          else if (s ~ /^"[^"]*"$/) name = substr(s, 2, length(s) - 2)
        }
        if (!steam) exit 3
        for (i = 1; i <= NR; i++) {
          print l[i]
          if (sys ? i == sys : i == steam) {
            c = (l[i] ~ /\r$/) ? "\r" : ""
            if (!sys) { print "\t\t\t\t\"system\"" c; print "\t\t\t\t{" c }
            print "\t\t\t\t\t\"" key "\"\t\t\"0\"" c
            if (!sys) print "\t\t\t\t}" c
          }
        }
      }' "$cfg" > "$tmp"
    rc=$?
    if (( rc != 0 )); then
      rm -f "$tmp"
      (( rc == 3 )) && return 0
      return 1
    fi
  fi
  mv -f "$tmp" "$cfg" || { rm -f "$tmp"; return 1; }
}
if ! set_idle_screensaver 2>/dev/null; then
  printf '%s\n' "quasar-steam: could not set Steam's screensaver timeout in $steam_dir/config; starting Steam anyway" >&2
fi

# Compatibility tools (accreleus/quasar#1068): the control plane sends the effective per-game
# mapping in QUASAR_COMPAT_TOOLS, space-separated `<appid>=<name>` tokens, `!` after the name for a
# forced one (appid 0 is Steam's "all other titles" slot and is never forced). Each one is written
# into config.vdf InstallConfigStore/Software/Valve/Steam/CompatToolMapping before Steam starts;
# Steam never re-reads the file and rewrites it from memory, so no other moment works.
#
# A user's own pick in Steam looks exactly like our write (name, config "", priority 250), so the
# wrapper records what it wrote in ~/.local/share/quasar/compat-tool-fills (`<appid>=<name>` per
# line). A forced entry replaces whatever is there. An unforced one is written only when the home
# has no entry for the appid or the entry is exactly what we last wrote; anything else is the
# user's and is kept. An entry we wrote whose appid is no longer sent is removed, unless the user
# has changed it. With no record, every entry counts as the user's. A name is checked again here,
# because it lands in Steam's config: Valve's names, or a directory in the mounted tools path.
# Unset QUASAR_COMPAT_TOOLS touches nothing. The failure handling is set_idle_screensaver's.
compat_name_ok() { # <name>
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || return 1
  [[ "$1" =~ ^proton_(experimental|hotfix|[0-9]{1,3})$ ]] && return 0
  local d; local -a dirs=()
  IFS=: read -r -a dirs <<<"${STEAM_EXTRA_COMPAT_TOOLS_PATHS:-}"
  for d in "${dirs[@]}"; do
    [[ -n "$d" && -d "$d/$1" ]] && return 0
  done
  return 1
}

# The names under CompatToolMapping, one `<appid><TAB><name>` line each.
compat_current_mapping() { # <config.vdf>
  awk '
    { s = $0; gsub(/^[ \t]+|[ \t]+$/, "", s); sub(/\r$/, "", s) }
    s == "{" { d++; p[d] = (d > 1 ? p[d - 1] "/" : "") tolower(name); next }
    s == "}" { d--; next }
    s ~ /^"[^"]*"$/ { name = substr(s, 2, length(s) - 2); next }
    d > 0 && tolower(s) ~ /^"name"[ \t]+"[^"]*"$/ {
      n = split(p[d], a, "/")
      if (n == 6 && a[1] "/" a[2] "/" a[3] "/" a[4] "/" a[5] == "installconfigstore/software/valve/steam/compattoolmapping") {
        v = s; sub(/^"[^"]*"[ \t]+"/, "", v); sub(/"$/, "", v); print a[6] "\t" v
      }
    }' "$1"
}

# Apply an ops file (`S<TAB>appid<TAB>name<TAB>priority` | `D<TAB>appid`) to config.vdf. Exit 3: no
# Steam block, so not a config Steam wrote.
compat_rewrite() { # <config.vdf> <ops> <out>
  awk -v ops="$2" '
    BEGIN {
      while ((getline line < ops) > 0) {
        split(line, f, "\t")
        if (f[1] == "S") { name[f[2]] = f[3]; prio[f[2]] = f[4]; order[++no] = f[2] } else del[f[2]] = 1
      }
    }
    function block(id, ind, c) {
      printf "%s\"%s\"%s\n%s{%s\n", ind, id, c, ind, c
      printf "%s\t\"name\"\t\t\"%s\"%s\n%s\t\"config\"\t\t\"\"%s\n%s\t\"priority\"\t\t\"%s\"%s\n", ind, name[id], c, ind, c, ind, prio[id], c
      printf "%s}%s\n", ind, c
    }
    { l[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        s = l[i]; gsub(/^[ \t]+|[ \t]+$/, "", s); sub(/\r$/, "", s)
        if (s == "{") {
          d++; start[d] = i; p[d] = (d > 1 ? p[d - 1] "/" : "") tolower(name_)
          if (p[d] == "installconfigstore/software/valve/steam") steam = i
          if (p[d] == "installconfigstore/software/valve/steam/compattoolmapping") cm = i
          if (p[d] ~ /^installconfigstore\/software\/valve\/steam\/compattoolmapping\/[^\/]+$/) {
            id = p[d]; sub(/.*\//, "", id); bs[id] = i - 1
          }
        } else if (s == "}") {
          if (p[d] == "installconfigstore/software/valve/steam/compattoolmapping") cmend = i
          if (p[d] ~ /^installconfigstore\/software\/valve\/steam\/compattoolmapping\/[^\/]+$/) {
            id = p[d]; sub(/.*\//, "", id); be[id] = i
          }
          d--
        } else if (s ~ /^"[^"]*"$/) name_ = substr(s, 2, length(s) - 2)
      }
      if (!steam) exit 3
      for (id in bs) { if ((id in name) || (id in del)) { for (k = bs[id]; k <= be[id]; k++) skip[k] = 1; if (id in name) at[bs[id]] = id; seen[id] = 1 } }
      c = (l[steam] ~ /\r$/) ? "\r" : ""
      for (i = 1; i <= NR; i++) {
        if (i in at) { block(at[i], substr(l[i], 1, match(l[i], /[^ \t]/) - 1), c); continue }
        if (i in skip) continue
        if (cm && i == cmend) for (k = 1; k <= no; k++) if (!(order[k] in seen)) block(order[k], "\t\t\t\t\t", c)
        print l[i]
        if (!cm && i == steam && no) {
          print "\t\t\t\t\"CompatToolMapping\"" c; print "\t\t\t\t{" c
          for (k = 1; k <= no; k++) block(order[k], "\t\t\t\t\t", c)
          print "\t\t\t\t}" c
        }
      }
    }' "$1" > "$3"
}

apply_compat_tools() {
  [[ -n "${QUASAR_COMPAT_TOOLS+x}" ]] || return 0
  local cfg="$steam_dir/config/config.vdf" rec_dir="$HOME/.local/share/quasar"
  local rec="$rec_dir/compat-tool-fills" id name forced tok line
  local -A want_name=() want_forced=() cur=() ours=() keep=()
  local -a toks=() order=()
  [[ -s "$cfg" ]] || return 1
  read -r -a toks <<<"$QUASAR_COMPAT_TOOLS"
  for tok in "${toks[@]}"; do
    forced=0
    [[ "$tok" == *'!' ]] && { forced=1; tok="${tok%!}"; }
    id="${tok%%=*}" name="${tok#*=}"
    if [[ "$tok" != *=* || ! "$id" =~ ^(0|[1-9][0-9]{0,9})$ ]] || ! compat_name_ok "$name" \
       || [[ "$id" == 0 && "$forced" == 1 ]] || [[ -n "${want_name[$id]+x}" ]]; then
      printf '%s\n' "quasar-steam: refusing compat tool entry '$tok'" >&2
      continue
    fi
    want_name[$id]="$name" want_forced[$id]="$forced"
    order+=("$id")
  done
  if [[ -s "$rec" ]]; then
    while IFS='=' read -r id name; do
      [[ "$id" =~ ^(0|[1-9][0-9]{0,9})$ && "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] && ours[$id]="$name"
    done <"$rec"
  fi
  while IFS=$'\t' read -r id name; do cur[$id]="$name"; done < <(compat_current_mapping "$cfg")

  local ops tmp out
  ops="$(mktemp "$steam_dir/config/.compat-ops.XXXXXX")" || return 1
  : >"$ops"
  for id in "${order[@]}"; do
    name="${want_name[$id]}"
    if [[ "${want_forced[$id]}" == 1 || -z "${cur[$id]+x}" || "${cur[$id]}" == "${ours[$id]:-}" ]]; then
      keep[$id]="$name"
      [[ "${cur[$id]:-}" == "$name" ]] && continue
      line="S"$'\t'"$id"$'\t'"$name"$'\t'"$([[ "$id" == 0 ]] && echo 75 || echo 250)"
      printf '%s\n' "$line" >>"$ops"
    fi
  done
  for id in "${!ours[@]}"; do
    [[ -n "${want_name[$id]+x}" ]] && continue
    [[ "${cur[$id]:-}" == "${ours[$id]}" ]] && printf 'D\t%s\n' "$id" >>"$ops"
  done
  if [[ -s "$ops" ]]; then
    tmp="$(mktemp "$steam_dir/config/.config.vdf.XXXXXX")" || { rm -f "$ops"; return 1; }
    chmod --reference="$cfg" "$tmp" || { rm -f "$ops" "$tmp"; return 1; }
    compat_rewrite "$cfg" "$ops" "$tmp"
    local rc=$?
    rm -f "$ops"
    if (( rc != 0 )); then
      rm -f "$tmp"
      (( rc == 3 )) && return 0
      return 1
    fi
    mv -f "$tmp" "$cfg" || { rm -f "$tmp"; return 1; }
  else
    rm -f "$ops"
  fi

  mkdir -p "$rec_dir" || return 1
  out="$(mktemp "$rec_dir/.compat-tool-fills.XXXXXX")" || return 1
  for id in "${!keep[@]}"; do printf '%s=%s\n' "$id" "${keep[$id]}"; done | sort -n >"$out" \
    || { rm -f "$out"; return 1; }
  mv -f "$out" "$rec" || { rm -f "$out"; return 1; }
}
if ! apply_compat_tools; then
  printf '%s\n' "quasar-steam: could not apply the compatibility tool mapping in $steam_dir/config; starting Steam anyway" >&2
fi

# Steam does not follow LANG (accreleus/quasar#848): a new home starts in English whatever
# language the launch asked for. Steam keeps its language in ~/.steam/registry.vdf and writes it
# back itself, so `-language <name>` once, on a new home, is enough; after that the language is
# Steam's (the user may change it there) and is never overridden. Steam's names are
# its API language codes (partner.steamgames.com/doc/store/localization/languages). English is
# Steam's default, so it gets no flag; a language outside this table gets none either.
steam_language_for() { # <LANG, e.g. de_DE.UTF-8> -> Steam's language name, or nothing
  local tag="${1%%.*}" ll rr
  tag="${tag%%@*}" # a glibc modifier (de_DE@euro, de_DE.UTF-8@euro) does not change the language
  [[ "$tag" =~ ^([a-z]{2,3})_([A-Z]{2})$ ]] || return 0
  ll="${BASH_REMATCH[1]}" rr="${BASH_REMATCH[2]}"
  case "$ll" in
    de) echo german ;;
    fr) echo french ;;
    it) echo italian ;;
    nl) echo dutch ;;
    pl) echo polish ;;
    sv) echo swedish ;;
    ru) echo russian ;;
    ja) echo japanese ;;
    ko) echo koreana ;;
    es) if [[ "$rr" == ES ]]; then echo spanish; else echo latam; fi ;;
    pt) if [[ "$rr" == BR ]]; then echo brazilian; else echo portuguese; fi ;;
    zh) if [[ "$rr" == TW || "$rr" == HK ]]; then echo tchinese; else echo schinese; fi ;;
  esac
  return 0
}

# Steam's own language (lowercased), or nothing: the "language" value directly in
# Registry/HKCU/Software/Valve/Steam of registry.vdf. A "language" key under another branch
# (Steam/Apps/<id>) or as some key's value is not it. The block walk is the one
# set_idle_screensaver uses; an absent, empty or unreadable file gives nothing.
steam_language_value() { # <registry.vdf>
  [[ -s "$1" ]] || return 0
  awk '
    { s = $0; gsub(/^[ \t]+|[ \t]+$/, "", s); sub(/\r$/, "", s) }
    s == "{" { d++; p[d] = (d > 1 ? p[d - 1] "/" : "") tolower(name); next }
    s == "}" { d--; next }
    s ~ /^"[^"]*"$/ { name = substr(s, 2, length(s) - 2); next }
    d > 0 && p[d] == "registry/hkcu/software/valve/steam" && tolower(s) ~ /^"language"[ \t]+"[^"]*"$/ {
      sub(/^"[^"]*"[ \t]+"/, "", s); sub(/"$/, "", s); print tolower(s); exit
    }' "$1" 2>/dev/null || true
}

# Rewrite Steam's language in registry.vdf to <name>: the "language" value in HKCU/Software/Valve/
# Steam and, if present, Steamsteamglobal. Steam itself persists its language only on a clean exit,
# so a launch that dies early would otherwise leave "english" next to the marker for good. Same
# atomic temp-file-and-rename as set_idle_screensaver; the file keeps its mode and line endings
# (trailing whitespace on a language line is dropped, as the detector ignores it). A symlinked
# registry.vdf is written through, the link kept. Fails when it replaced nothing, so the caller
# never records a language the registry does not carry.
set_steam_language_registry() { # <registry.vdf> <name>
  local reg="$1" tmp
  if [[ -L "$reg" ]]; then reg="$(readlink -f "$reg")" || return 1; fi
  tmp="$(mktemp "$(dirname "$reg")/.registry.vdf.XXXXXX")" || return 1
  chmod --reference="$reg" "$tmp" || { rm -f "$tmp"; return 1; }
  awk -v lang="$2" '
    { line = $0; s = $0; gsub(/^[ \t]+|[ \t]+$/, "", s); sub(/\r$/, "", s) }
    s == "{" { d++; p[d] = (d > 1 ? p[d - 1] "/" : "") tolower(name) }
    s == "}" { d-- }
    s ~ /^"[^"]*"$/ { name = substr(s, 2, length(s) - 2) }
    d > 0 && (p[d] == "registry/hkcu/software/valve/steam" || p[d] == "registry/hkcu/software/valve/steamsteamglobal") \
      && tolower(s) ~ /^"language"[ \t]+"[^"]*"$/ {
        if (sub(/"[^"]*"[ \t\r]*$/, "\"" lang "\"" (line ~ /\r[ \t]*$/ ? "\r" : ""), line)) n++
      }
    { print line }
    END { exit (n == 0) }' "$reg" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$reg" || { rm -f "$tmp"; return 1; }
}

cd "$steam_dir"
# STEAM_STARTUP_FLAGS is normally computed by quasar-steam (from the catalog's
# Steam runtime preset or an explicit QUASAR_STEAM_UI_MODE opt-in). There is no
# fallback here: unset or empty means Steam gets no UI-mode flag.
read -r -a steam_args <<< "${STEAM_STARTUP_FLAGS:-}"
# A home is "new" for its language when registry.vdf has none, or has only the "english" Steam
# writes on its first start. That second case is every home whose registry says english and has no
# marker: a home seeded from a golden-home template (the template's Steam booted once,
# accreleus/quasar#934), a home made before this existed, and one where the user picked English
# earlier. They cannot be told apart, so a marker records that the launch's language was applied
# here: with the marker the registry is the user's, and the language is never set again. No marker
# is written when nothing is applied (English, an unmapped language), so a later non-English
# launch still applies once. A template stays marker-free only because its warm-up runs the app
# under the image's own LANG, which scripts/verify.sh pins to en_US.UTF-8 (nothing is applied
# then): a warm-up must never run the app under a non-English LANG, or every home seeded from it
# would carry that language and its marker.
# The registry is rewritten in the same step as the marker, so a first launch that dies before
# Steam writes its own language leaves the two agreeing; if either write fails, no flag is passed
# and the next launch tries again.
steam_registry="$(dirname "$legacy_dir")/registry.vdf"
steam_marker="$(dirname "$legacy_dir")/.quasar-steam-language"
steam_current="$(steam_language_value "$steam_registry")"
if [[ -z "$steam_current" || ( "$steam_current" == english && ! -e "$steam_marker" ) ]]; then
  steam_language="$(steam_language_for "${LANG:-}")"
  # An explicit -language (the preset's flags, or the caller's) wins.
  if [[ -n "$steam_language" && " ${steam_args[*]:-} $* " != *" -language "* ]]; then
    steam_ok=1 steam_rewritten=0
    if [[ -n "$steam_current" ]]; then
      if set_steam_language_registry "$steam_registry" "$steam_language" 2>/dev/null; then
        steam_rewritten=1
      else
        printf '%s\n' "quasar-steam: could not set Steam's language in $steam_registry; starting Steam without it" >&2
        steam_ok=0
      fi
    fi
    if [[ "$steam_ok" == 1 ]] && ! printf '%s\n' "$steam_language" 2>/dev/null > "$steam_marker"; then
      if [[ "$steam_rewritten" == 1 ]]; then
        printf '%s\n' "quasar-steam: could not record Steam's language in $steam_marker; the registry already carries it, so Steam starts in it" >&2
      else
        printf '%s\n' "quasar-steam: could not record Steam's language in $steam_marker; starting Steam without it" >&2
      fi
      steam_ok=0
    fi
    if [[ "$steam_ok" == 1 ]]; then
      steam_args+=(-language "$steam_language")
    fi
  fi
fi
exec ./steam.sh "${steam_args[@]}" "$@"
