#!/usr/bin/env bash
set -euo pipefail

# --- Wayland socket handoff (quasar#379) -------------------------------------
# The node-agent provides XDG_RUNTIME_DIR + WAYLAND_DISPLAY for ITS compositor
# socket (a file bind at $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY, e.g.
# /run/quasar-wayland/wayland-3 -- the name varies per session). Gamescope
# needs a private, user-owned XDG_RUNTIME_DIR for its own sockets, so this
# launcher repoints it below -- but first the agent socket is resolved to an
# ABSOLUTE path so the repoint cannot orphan it. (A hardcoded wayland-1
# catalog env pin previously did this job and broke every non-first session
# on the host.)
if [[ -n "${WAYLAND_DISPLAY:-}" && "${WAYLAND_DISPLAY}" != /* ]]; then
  export WAYLAND_DISPLAY="${XDG_RUNTIME_DIR:-/run/quasar-wayland}/${WAYLAND_DISPLAY}"
fi
export XDG_RUNTIME_DIR="${QUASAR_STEAM_RUNTIME_DIR:-$HOME/.runtime}"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 0700 "$XDG_RUNTIME_DIR"

log() { printf '%s quasar-steam: %s\n' "$(date -Iseconds)" "$*" >&2; }

# --- Phase B: session state-file reporting (game-exit-lifecycle spec §B.1) --
# When the node-agent wants launch-state reporting it bind-mounts a per-session
# directory into the container (rw for our uid) at this path; an old agent, or
# a bare `docker run`, never creates it. Every write below tests the directory
# first and silently no-ops when it is absent/unwritable -- zero behaviour
# change for anyone not reading the file. Atomic: write to a tmpfile in the
# SAME directory (so the rename is same-filesystem, never cross-device), then
# rename over the published name -- a reader never observes a partial line.
# Guarded end-to-end so a write can never trip `set -e` and abort the
# launcher: the early return and the trailing `return 0` mean this function's
# exit status is always 0 regardless of what printf/mv/rm did.
QUASAR_SESSION_STATE_DIR="${QUASAR_SESSION_STATE_DIR:-/run/quasar/session}"
write_app_state() {
  local state="$1" dir="$QUASAR_SESSION_STATE_DIR" tmp
  [[ -d "$dir" && -w "$dir" ]] || return 0
  tmp="$dir/.app-state.$$.tmp"
  if printf '%s\n' "$state" > "$tmp" 2>/dev/null; then
    mv -f -- "$tmp" "$dir/app-state" 2>/dev/null || true
  fi
  rm -f -- "$tmp" 2>/dev/null || true
  return 0
}

export STEAM_COMPAT_DATA_PATH="${STEAM_COMPAT_DATA_PATH:-$HOME/.local/share/quasar-steam/pfx}"
export WINEPREFIX="${WINEPREFIX:-$STEAM_COMPAT_DATA_PATH}"

# Steam/Gamescope environment, mirrored from the games-on-whales steam app
# (apps/steam/build-fedora/scripts/startup.sh) — the validated reference:
#   - keep games running when the nested Gamescope window loses focus
#   - let Steam drive Gamescope's fancy (integer/FSR) scaling
#   - route Qt/GTK input methods through Steam's on-screen keyboard
#   - expose VRAM to Proton titles (dxgi from Wine, not the builtin)
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS="${SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS:-0}"
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT="${STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT:-1}"
export STEAM_GAMESCOPE_HDR_SUPPORTED="${STEAM_GAMESCOPE_HDR_SUPPORTED:-0}"
export QT_IM_MODULE="${QT_IM_MODULE:-steam}"
export GTK_IM_MODULE="${GTK_IM_MODULE:-Steam}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-dxgi=n}"

# --- Steam UI mode & the game-foreground handoff -----------------------------
# In nested Gamescope, pressing "Play" only brings the game to the foreground if
# Gamescope can focus the game's window. Gamescope's Steam-integration focus is
# X11-atom driven (STEAM_GAME per-window appID + GAMESCOPECTRL_BASELAYER_APPID on
# the root window), and is independent of whether Steam is a child of Gamescope
# (games-on-whales and Valve's own gamescope-session both launch Steam as a
# sibling X client). Two validated configurations exist:
#
#   bigpicture  (default) - legacy Big Picture, `-bigpicture`. Steam does NOT pin
#               GAMESCOPECTRL_BASELAYER_APPID, so Gamescope's default focus raises
#               the newest STEAM_GAME-tagged window (the launched game). This is
#               the games-on-whales-validated path and the robust default here.
#   gamepadui   - modern Deck UI. Requires Steam to run in a full SteamOS session
#               (`-gamepadui -steamos3 -steampal -steamdeck` + STEAM_MULTIPLE_XWAYLANDS=1)
#               so Steam tags game windows and manages the baselayer handoff.
#               A PARTIAL gamepadui config (e.g. `-gamepadui` alone) pins focus to
#               the Steam UI forever and never releases it to launched games -
#               this is the defect this image fixes, so the flags ship as a
#               validated unit, never partially.
#
# STEAM_STARTUP_FLAGS overrides the computed flags verbatim (advanced use).
ui_mode="${QUASAR_STEAM_UI_MODE:-bigpicture}"
case "$ui_mode" in
  bigpicture)
    default_flags="-bigpicture"
    multi_xwayland_default=0
    ;;
  gamepadui)
    default_flags="-gamepadui -steamos3 -steampal -steamdeck"
    multi_xwayland_default=1
    ;;
  *)
    log "unknown QUASAR_STEAM_UI_MODE='$ui_mode'; falling back to bigpicture"
    default_flags="-bigpicture"
    multi_xwayland_default=0
    ;;
esac
export STEAM_STARTUP_FLAGS="${STEAM_STARTUP_FLAGS:-$default_flags}"

# --- Game-exit watcher: arming ------------------------------------------------
# A derived (game) tile launches straight into a title via `-applaunch
# <appid>` in STEAM_STARTUP_FLAGS; when that game exits the user should not
# land back in Big Picture -- the session should end (Michael, 2026-08-02
# game-exit-lifecycle spec, Phase A). A plain launcher-tile session (no
# -applaunch) never arms the watcher: behaviour is unchanged.
#
# Parsed here (STEAM_STARTUP_FLAGS is already final) rather than at watcher
# start, so a malformed/missing -applaunch pair degrades to today's
# behaviour with no side effects -- watch_appid stays empty and none of the
# watcher machinery below ever runs. QUASAR_STEAM_EXIT_ON_GAME_EXIT=0 is the
# operator/debug escape hatch even when a valid pair is present.
watch_appid=""
if [[ "${QUASAR_STEAM_EXIT_ON_GAME_EXIT:-1}" == "1" ]]; then
  read -r -a _flags <<< "${STEAM_STARTUP_FLAGS:-}"
  for ((_i = 0; _i < ${#_flags[@]}; _i++)); do
    if [[ "${_flags[$_i]}" == "-applaunch" && "${_flags[$((_i + 1))]:-}" =~ ^[1-9][0-9]{0,9}$ ]]; then
      watch_appid="${_flags[$((_i + 1))]}"
    fi
  done
  unset _flags _i
fi

# Per-game Xwayland isolation is part of the validated gamepadui unit and stays
# off for bigpicture. Gamescope composites every Xwayland into one output, so the
# node-agent's compositor capture is unaffected either way.
if [[ "${QUASAR_STEAM_MULTIPLE_XWAYLANDS:-$multi_xwayland_default}" == "1" ]]; then
  export STEAM_MULTIPLE_XWAYLANDS=1
fi

# --- Launch requirement diagnostics (non-fatal) ------------------------------
# Steam's Chromium command buffers need a large /dev/shm; Docker's 64 MB default
# yields a black/flashing UI. The image cannot raise this - the launcher must be
# run with `--shm-size=1g` (or equivalent). Warn loudly if it looks too small.
shm_kb="$(df -Pk /dev/shm 2>/dev/null | awk 'NR==2{print $2}' || true)"
if [[ "$shm_kb" =~ ^[0-9]+$ && "$shm_kb" -lt 262144 ]]; then
  log "WARNING: /dev/shm is only $((shm_kb / 1024)) MiB; Steam needs >=1 GiB (run with --shm-size=1g)."
fi

# 32-bit Steam and games need 32-bit GL/Vulkan userspace. The image deliberately
# does not bake NVIDIA driver libs (they are driver-version coupled); the host's
# container runtime must inject the 32-bit driver libs (NVIDIA_DRIVER_CAPABILITIES
# including graphics+compat32). Warn if NVIDIA 64-bit GL is present but 32-bit is not.
if [[ -e /usr/lib64/libGLX_nvidia.so.0 ]] \
   && ! { ldconfig -p 2>/dev/null | grep -F 'libGLX_nvidia.so.0 (libc6)' | grep -qv 'x86-64'; }; then
  log "WARNING: 64-bit NVIDIA GL present but 32-bit libGLX_nvidia.so.0 was not injected;"
  log "         32-bit Steam/games will fail. See images/quasar-steam/README.md (host requirements)."
fi

client=(dbus-run-session -- /usr/local/bin/quasar-steam-client "$@")

# --- Graceful shutdown: launcher-owned sequenced relay (quasar-images#1) -----
# images/quasar-base/Dockerfile's tini no longer runs with -g, so `docker stop`
# SIGTERMs only this launcher (tini's direct child) -- this script now owns
# relaying that shutdown to gamescope/Steam itself, in order, instead of
# `exec`ing the client chain away. No process-group tricks anywhere below:
# every process stays in tini's direct descendant tree, so there is no group
# to kill and no way to reproduce the 6551fe8 FATAL (EPERM from a group-kill
# against a reshaped process group under --cap-drop ALL/no CAP_KILL).
shutdown_timeout="${QUASAR_STEAM_SHUTDOWN_TIMEOUT:-8}"
# A non-numeric override must not silently collapse the budget to a
# zero-wait escalation -- fall back to the documented default instead.
[[ "$shutdown_timeout" =~ ^[0-9]+$ ]] || shutdown_timeout=8
client_pid=""
gs_pid=""
shutting_down=0
watcher_pid=""
game_exit_confirmed=0
launcher_pid=$$

# A pid only counts as "the steam process" if it is numeric, alive, AND
# /proc confirms its comm is exactly "steam". kill -0 alone is not enough:
# steam.pid persists on the (mounted) home directory across container
# restarts, while a fresh container's pids are low and predictable, so a
# stale steam.pid colliding with an unrelated live process is the likeliest
# failure mode -- especially during the 60-150s bootstrap window before
# Steam itself is up. A comm mismatch falls through to the pgrep fallback.
pid_is_steam() {
  local pid="$1"
  [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(cat "/proc/$pid/comm" 2>/dev/null || true)" == "steam" ]]
}

# Resolves the live steam ELF process pid (not steam.sh, not the launcher).
# Steam writes its own pid to $HOME/.steam/steam.pid; `pgrep -x steam` is the
# fallback (comm "steam" is unique at steady state -- srt-bwrap/steamwebhelper
# have different comms). Prints nothing if no live pid can be resolved (first
# boot / bootstrap incomplete).
resolve_steam_pid() {
  local pid=""
  if [[ -f "$HOME/.steam/steam.pid" ]]; then
    pid="$(cat "$HOME/.steam/steam.pid" 2>/dev/null || true)"
  fi
  if ! pid_is_steam "$pid"; then
    pid="$(pgrep -x steam 2>/dev/null | head -n1 || true)"
  fi
  if pid_is_steam "$pid"; then
    printf '%s' "$pid"
  fi
}

# --- Game-exit watcher: detection --------------------------------------------
# Primary signal: Steam wraps every launched title (native and Proton) in its
# `reaper` process with the literal argument `AppId=<appid>`. Iterate
# /proc/*/cmdline (NUL-separated, own-uid processes readable unprivileged)
# and compare the token EXACTLY -- a substring/regex match here would let
# "AppId=620" match a process actually running "AppId=6200" (or the reverse),
# and `pgrep -f` carries its own well-known self-match/substring traps (on
# record from resolve_steam_pid's history above). This is deliberately the
# more verbose of the two documented detection options for that reason.
game_running() {
  local proc tok
  for proc in /proc/[0-9]*/cmdline; do
    [[ -r "$proc" ]] || continue
    while IFS= read -r -d '' tok; do
      if [[ "$tok" == "AppId=${watch_appid}" ]]; then
        return 0
      fi
    done < "$proc" 2>/dev/null
  done
  return 1
}

# Corroborating signal: Steam's own registry carries "RunningAppID" "<appid>"
# while a game runs and "0" after it exits. It lags process death by a beat
# -- exactly what makes it a debounce witness, not a primary. Single
# sed/grep, no VDF parser. Empty output means the file is missing/unreadable
# (first boot) or carries no RunningAppID line.
registry_running_appid() {
  local registry_file="$HOME/.steam/registry.vdf"
  [[ -r "$registry_file" ]] || return 0
  sed -n 's/.*"RunningAppID"[[:space:]]*"\([0-9]*\)".*/\1/p' "$registry_file" | tail -n1
}

# --- Game-exit watcher: foreground gate (Phase B, spec §B.1 "Foreground
# polish", A.3 foreground paragraph) ------------------------------------------
# `game_running` above only proves the title's process exists; it says
# nothing about whether gamescope has actually brought it to the front (vs.
# it sitting behind the Steam UI while shaders compile, or a title that never
# gets focused). QUASAR_STEAM_FOREGROUND_CHECK gates the watcher's
# waiting_for_start -> running transition on gamescope's X root atoms
# corroborating "on screen", not just "alive" -- see game_exit_watcher()'s
# use of this below for the bounded (10s) process-only fallback that keeps a
# title gamescope never tags from wedging the watcher forever.
#
# foreground_gate_active() is the single degrade point: knob off, no
# DISPLAY (QUASAR_STEAM_GAMESCOPE=0 -- no nested Xwayland to query), or no
# xprop binary in the image all fall through to plain process-only detection,
# exactly Phase A behaviour. This is deliberately checked fresh on every
# watcher tick rather than cached once, so it stays correct even though none
# of these three things can actually change mid-session today.
foreground_gate_active() {
  [[ "${QUASAR_STEAM_FOREGROUND_CHECK:-1}" == "1" ]] || return 1
  [[ -n "${DISPLAY:-}" ]] || return 1
  command -v xprop >/dev/null 2>&1 || return 1
  return 0
}

# Matches watch_appid as a whole numeric token inside an xprop property dump
# (e.g. `GAMESCOPECTRL_BASELAYER_APPID(CARDINAL) = 620`) -- the same
# no-substring-match discipline as game_running's AppId= comparison above, so
# appid 620 can never match a dump carrying 6200 or vice versa.
_atom_matches_appid() {
  [[ "$1" =~ (^|[^0-9])${watch_appid}([^0-9]|$) ]]
}

# Two corroborating atoms, either is sufficient, queried against the nested
# gamescope X root ($DISPLAY, exported once gamescope reports ready):
#   - GAMESCOPECTRL_BASELAYER_APPID (root window): gamescope's own idea of
#     which appid currently owns the base layer.
#   - STEAM_GAME (per top-level window): Steam tags each game window with its
#     appid; walk the root's stacking-order window list and check each
#     window's STEAM_GAME atom, newest (topmost) window first.
# Best-effort by construction: any xprop failure, an untagged window, or a
# title gamescope never tags all just return 1 -- the caller's bounded grace
# window is what keeps this from wedging the watcher, not this function.
game_foreground() {
  local baselayer
  baselayer="$(xprop -root GAMESCOPECTRL_BASELAYER_APPID 2>/dev/null || true)"
  if [[ -n "$baselayer" ]] && _atom_matches_appid "$baselayer"; then
    return 0
  fi

  local client_list steam_game
  client_list="$(xprop -root _NET_CLIENT_LIST_STACKING 2>/dev/null || true)"
  [[ -n "$client_list" ]] || return 1
  local -a wins=()
  mapfile -t wins < <(grep -oE '0x[0-9a-fA-F]+' <<< "$client_list" || true)
  local i
  for (( i=${#wins[@]}-1; i>=0; i-- )); do
    steam_game="$(xprop -id "${wins[$i]}" STEAM_GAME 2>/dev/null || true)"
    if [[ -n "$steam_game" ]] && _atom_matches_appid "$steam_game"; then
      return 0
    fi
  done
  return 1
}

on_term() {
  # Idempotent: a second TERM/INT while a relay is already in flight is a
  # no-op -- the first invocation owns the steam-TERM -> client TERM ->
  # gamescope TERM sequence through to completion.
  if [[ "$shutting_down" == "1" ]]; then
    return
  fi
  shutting_down=1
  log "shutdown requested; relaying to launched processes"

  # Declared here (not inside the client_pid branch below) so it is always
  # in scope for the gamescope-TERM gate further down, even on the startup
  # paths where client_pid is never set and that branch is skipped entirely.
  local steam_pid=""

  if [[ -n "$client_pid" ]] && kill -0 "$client_pid" 2>/dev/null; then
    steam_pid="$(resolve_steam_pid)"

    if [[ -n "$steam_pid" ]]; then
      # Clean quit, live-tested 2026-07-20 (2x oracle-verified): a single
      # SIGTERM to the steam ELF process itself is what makes Steam log
      # "Shutdown" and unwind the whole chain (steam.sh -> dbus-run-session
      # -> launcher) on its own -- container exits ~3.1-3.4s later, next boot
      # is clean. steam.sh's shutdown flag was tried first and PROVEN
      # INEFFECTIVE in this container: it is forwarded over Steam's client
      # IPC to the already-running instance and silently ignored (nothing
      # exits within 61s), so it is not invoked anywhere in this script.
      # TERM'ing gamescope while steam is still alive is also PROVEN UNCLEAN (gamescope's death
      # races steam's own exit), which is why gamescope's TERM below stays
      # strictly after steam has exited (or the budget below expires).
      log "sending SIGTERM to steam (pid $steam_pid, budget ${shutdown_timeout}s)"
      kill -TERM "$steam_pid" 2>/dev/null || true

      local waited=0
      local max_waited=$(( shutdown_timeout * 4 ))  # 0.25s poll ticks
      while kill -0 "$steam_pid" 2>/dev/null; do
        if (( waited >= max_waited )); then
          log "steam still running after ${shutdown_timeout}s; escalating to TERM"
          break
        fi
        sleep 0.25 || true
        waited=$((waited + 1))
      done
    else
      # First boot, or steam hasn't finished bootstrapping yet: no live steam
      # pid to resolve, so skip straight to the TERM relay below.
      log "no live steam process resolved yet; skipping steam TERM, relaying TERM directly"
    fi

    if kill -0 "$client_pid" 2>/dev/null; then
      kill -TERM "$client_pid" 2>/dev/null || true
    fi
  fi

  # Gated on steam being confirmed gone: TERM'ing gamescope while steam is
  # still alive is proven unclean (gamescope's death races steam's own
  # exit). If the budget above expired with steam still running, this is
  # deliberately a no-op -- docker's SIGKILL-after-timeout backstop reaps
  # gamescope instead of us risking the unclean race. When steam_pid was
  # never resolved (empty, startup-path fallback), `kill -0 ""` fails, the
  # negation is true, and gamescope's TERM still fires as before.
  if [[ -n "$gs_pid" ]] && ! kill -0 "$steam_pid" 2>/dev/null && kill -0 "$gs_pid" 2>/dev/null; then
    log "terminating gamescope (pid $gs_pid)"
    kill -TERM "$gs_pid" 2>/dev/null || true
  fi

  # Stop the game-exit watcher too, if one is running -- it has nothing left
  # to watch for once shutdown is under way. Harmless if it already exited
  # on its own (the confirmed-exit path returns after signaling us).
  if [[ -n "$watcher_pid" ]] && kill -0 "$watcher_pid" 2>/dev/null; then
    kill -TERM "$watcher_pid" 2>/dev/null || true
  fi
}

# --- Game-exit watcher: state machine ----------------------------------------
# Runs as a backgrounded function (`&`) -- a forked subshell of this script,
# so it stays in tini's direct descendant tree exactly like every other
# process here (no process-group tricks, per quasar-images#1 SS2 -- see the
# on_term()/pid_is_steam() header comments above for why). Traps are reset
# at entry: the subshell otherwise inherits this script's TERM/INT/USR1
# handlers, which would make a plain `kill -TERM "$watcher_pid"` re-enter
# on_term() a second time (harmlessly, but pointlessly) instead of just
# stopping the loop.
#
# The watcher does NOT call on_term() itself -- it runs in a forked
# subshell, so any variable it set there (shutting_down, game_exit_confirmed)
# would be a private copy of the fork and would never reach the main
# script's process. Instead, on confirmed exit it signals the main process
# (SIGUSR1) and lets THAT process's own trap run the real on_term(), which is
# the one that actually owns client_pid/gs_pid/shutting_down. This is also
# what makes a `docker stop` arriving while the watcher is already tearing
# things down a clean no-op second entry: both the TERM/INT handler and the
# USR1 handler funnel into the same on_term(), guarded by the same
# shutting_down flag, in the same process -- no new idempotency logic
# needed, the existing guard already covers it.
game_exit_watcher() {
  trap - TERM INT USR1

  local state="waiting_for_start"
  local debounce_window="${QUASAR_STEAM_GAME_EXIT_DEBOUNCE:-15}"
  [[ "$debounce_window" =~ ^[0-9]+$ ]] || debounce_window=15
  local debounce_elapsed=0
  local extended=0
  local running_appid=""
  # Foreground-gate bookkeeping (waiting_for_start -> running only, see
  # foreground_gate_active()/game_foreground() above): process_since is the
  # epoch second the process was first observed this arming cycle, reset
  # whenever the process is not seen; foreground_grace is the bounded window
  # (spec-decided 10s) after which an unconfirmed foreground falls back to
  # process-only rather than wedging the watcher on a title gamescope never
  # tags.
  local process_since=0
  local foreground_grace=10

  log "game-exit watcher armed for appid $watch_appid (debounce ${debounce_window}s)"

  while :; do
    case "$state" in
      waiting_for_start)
        # No timeout -- first-run EULAs, shader precompile, and Steam client
        # updates legitimately precede launch by minutes. The stream is up
        # and usable throughout; docker-level session stop still works.
        if game_running; then
          if foreground_gate_active; then
            if [[ "$process_since" == "0" ]]; then
              process_since="$(date +%s)"
              log "game $watch_appid process detected; awaiting foreground confirmation (grace ${foreground_grace}s)"
            fi
            if game_foreground; then
              log "game $watch_appid detected running and foreground-confirmed"
              state="running"
              write_app_state game_running
              continue
            fi
            local now
            now="$(date +%s)"
            if (( now - process_since >= foreground_grace )); then
              log "game $watch_appid process running but foreground not confirmed within ${foreground_grace}s; falling back to process-only"
              state="running"
              write_app_state game_running
              continue
            fi
            sleep 1
            continue
          fi
          log "game $watch_appid detected running"
          state="running"
          write_app_state game_running
          continue
        fi
        process_since=0
        sleep 2
        ;;
      running)
        if ! game_running; then
          log "game $watch_appid process no longer detected; entering debounce"
          state="debounce"
          debounce_elapsed=0
          extended=0
          continue
        fi
        sleep 2
        ;;
      debounce)
        sleep 1
        debounce_elapsed=$((debounce_elapsed + 1))
        if game_running; then
          log "game $watch_appid reappeared during debounce; resuming running state"
          state="running"
          write_app_state game_running
          continue
        fi
        if (( debounce_elapsed < debounce_window )); then
          continue
        fi
        running_appid="$(registry_running_appid)"
        if [[ "$running_appid" == "$watch_appid" && "$extended" == "0" ]]; then
          # Registry lag: process signal already says gone, but the
          # registry witness hasn't caught up yet. Extend once, then trust
          # the process signal regardless of what the registry says next.
          log "debounce expired but registry still reports appid $watch_appid running; extending once"
          extended=1
          debounce_elapsed=0
          continue
        fi
        state="confirmed"
        ;;
      confirmed)
        log "game $watch_appid exited; initiating clean shutdown"
        # Written BEFORE the USR1 self-signal (below) so the main process's
        # own final teardown read of the state file sees game_exited, not a
        # stale game_running -- the ordering is the point, not just the write.
        write_app_state game_exited
        kill -USR1 "$launcher_pid" 2>/dev/null || true
        return 0
        ;;
    esac
  done
}

# Installed before anything below is backgrounded: no window where a TERM/INT
# could arrive and find no handler wired up.
trap on_term TERM INT
# See game_exit_watcher()'s header comment: the watcher signals confirmed
# game exit via USR1 rather than calling on_term() itself, so that the
# relay (and the shutting_down idempotency guard) always runs in this
# process. game_exit_confirmed shapes the exit status below to 0 -- this is
# the success path, not a failure/docker-stop-style signal exit.
trap 'game_exit_confirmed=1; on_term' USR1

# `wait PID` returns EARLY (status >128) the instant a trapped signal is
# caught -- bash runs the trap synchronously, then hands control back to the
# statement after wait, whether or not PID has actually exited yet. Re-wait
# in a loop and only trust the exit status once `kill -0` confirms the pid is
# actually gone (that final wait's status is the real one; earlier ones are
# just signal-delivery artifacts). set -e is live, so every wait/kill here is
# the condition of an if/while -- never a bare statement -- or its nonzero
# would abort the script before we get to read $?.
wait_for_exit() {
  local pid="$1" rc=0
  while :; do
    if wait "$pid"; then rc=0; else rc=$?; fi
    if kill -0 "$pid" 2>/dev/null; then
      continue
    fi
    break
  done
  return "$rc"
}

if [[ "${QUASAR_STEAM_GAMESCOPE:-1}" != "1" ]]; then
  # Re-check right before backgrounding: a TERM/INT could have landed during
  # the diagnostics above (on_term already ran -- shutting_down=1, nothing
  # left to relay to since client_pid isn't set yet). Don't start Steam into
  # a shutdown that's already in flight.
  if [[ "$shutting_down" == "1" ]]; then
    log "shutdown requested during startup; exiting without launching Steam"
    exit 143
  fi
  "${client[@]}" &
  client_pid=$!
  # Client is up (armed or not): report client_only before the watcher (if
  # any) can ever observe the game running -- see write_app_state's header
  # comment. A launcher tile (watch_appid empty) writes this once and never
  # writes a game_* state, since game_exit_watcher never runs for it.
  write_app_state client_only
  if [[ -n "$watch_appid" ]]; then
    game_exit_watcher &
    watcher_pid=$!
  fi
  # A non-zero/signal exit here (e.g. 143) after an already-clean shutdown
  # relay is expected docker-stop signal-exit semantics, not a failure --
  # intentional, left as-is.
  if wait_for_exit "$client_pid"; then rc=0; else rc=$?; fi
  # Game-exit-initiated shutdown is the success path (the user quit the
  # game, not a crash or an external stop) -- exit 0 regardless of the
  # signal-shaped exit status client_pid actually returned.
  if [[ "$game_exit_confirmed" == "1" ]]; then
    log "clean shutdown after game exit; exiting 0"
    rc=0
  fi
  exit "$rc"
fi

# --- Gamescope launch: GOW-pattern ready-socket handshake --------------------
# Mirrors games-on-whales apps/steam startup.sh (the validated-working input
# path). Key structural points, each load-bearing:
#   1. Gamescope runs WITHOUT a client argument; Steam is started as a SIBLING
#      afterwards. Passing Steam as gamescope''s child arg left it mis-wired
#      (no DISPLAY / outer WAYLAND_DISPLAY) and input never reached it.
#   2. `-R socket`: gamescope reports its actual X display + nested Wayland
#      socket through the ready socket; we export exactly what it reports
#      instead of guessing ":0".
#   3. ibus-daemon is started (QT_IM_MODULE=steam needs it; without the daemon
#      the Steam IME can eat keyboard input). It self-daemonizes (double-forks
#      and reparents to tini, not to this launcher), so on_term() above never
#      sends it a TERM -- that's fine, `docker stop`'s SIGKILL-after-timeout
#      backstop reaps it like any other orphan under tini's subreaper.
export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1
gs_tmpdir=$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" -d -t gamescope.XXXXXXX)
gs_socket="$gs_tmpdir/startup.socket"
gs_stats="$gs_tmpdir/stats.pipe"
mkfifo -- "$gs_stats"
mkfifo -- "$gs_socket"

# Nested gamescope does not read the host compositor's wl_output mode -- it
# sizes its virtual output from -W/-H/-r. So whatever it is given here is the
# display Steam and every game it launches see. Quasar injects the session's
# streamed mode as QUASAR_STREAM_WIDTH/HEIGHT/FPS (quasar#384); before that the
# baked 1920x1080x60 defaults below applied to every session, so a 1440p120
# session rendered 1080p60 and the compositor upscaled it. An explicit
# GAMESCOPE_* still wins (per-app pin, and what Quasar's compatibility shim
# sets); the literals are the last resort for a standalone `docker run`.
gs_width="${GAMESCOPE_WIDTH:-${QUASAR_STREAM_WIDTH:-1920}}"
gs_height="${GAMESCOPE_HEIGHT:-${QUASAR_STREAM_HEIGHT:-1080}}"
gs_refresh="${GAMESCOPE_REFRESH:-${QUASAR_STREAM_FPS:-60}}"

log "starting Gamescope (mode=$ui_mode ${gs_width}x${gs_height}@${gs_refresh} flags='$STEAM_STARTUP_FLAGS' multi_xwayland=${STEAM_MULTIPLE_XWAYLANDS:-0})"
gamescope -e ${GAMESCOPE_MODE:--b} -R "$gs_socket" -T "$gs_stats" \
  -W "$gs_width" \
  -H "$gs_height" \
  -r "$gs_refresh" &
gs_pid=$!

# Readiness window. 5s was too tight: gamescope's own startup (Xwayland +
# xkbcomp keysym compile + Vulkan/EGL init) measured 4.5-10.6s on Tower with the
# time varying run to run and NOT with the requested mode (1440p120 came up in
# 6.1s between two 1080p60 runs at 10.6s and 4.6s). Losing that race aborted the
# whole container with "gamescope did not report ready", i.e. a dead session for
# a healthy gamescope. The wait is bounded, not removed -- a genuinely wedged
# gamescope still fails, just after a window it cannot lose by being slow.
gs_ready_timeout="${QUASAR_GAMESCOPE_READY_TIMEOUT:-30}"
if read -r -t "$gs_ready_timeout" gs_x_display gs_wl_display <> "$gs_socket"; then
  export DISPLAY="$gs_x_display"
  export GAMESCOPE_WAYLAND_DISPLAY="$gs_wl_display"
  unset WAYLAND_DISPLAY
  log "gamescope ready: DISPLAY=$DISPLAY nested_wayland=$gs_wl_display"
elif [[ "$shutting_down" == "1" ]]; then
  # A TERM/INT landed while waiting on the ready socket -- on_term already
  # TERM'd gamescope (steam_pid is empty at this point in startup, so the
  # gate above still fires), so the read timing/failing out is expected,
  # not a real gamescope fault. Exit the documented shutdown-during-startup
  # way instead of the misleading FATAL below.
  log "shutdown requested during startup; exiting without launching Steam"
  exit 143
else
  log "FATAL: gamescope did not report ready within ${gs_ready_timeout}s"
  exit 1
fi

# Gate: a TERM/INT could have landed anywhere between gamescope becoming ready
# and here (on_term already ran -- shutting_down=1, client_pid still unset so
# on_term had nothing of Steam's to relay to, but it did TERM gamescope).
# Without this check the flow below would start Steam into an already-dying
# (or dead) gamescope, which begins writing state and then gets SIGKILLed by
# the docker-stop backstop -- exactly the unclean shutdown this feature
# exists to prevent.
if [[ "$shutting_down" == "1" ]]; then
  log "shutdown requested during startup; exiting without launching Steam"
  exit 143
fi

if command -v ibus-daemon >/dev/null 2>&1; then
  ibus-daemon -d -r --panel=disable --emoji-extension=disable || log "WARN: ibus-daemon failed to start"
fi

# Re-check immediately before backgrounding: the ibus-daemon startup above is
# another window where a signal could have landed.
if [[ "$shutting_down" == "1" ]]; then
  log "shutdown requested during startup; exiting without launching Steam"
  exit 143
fi

"${client[@]}" &
client_pid=$!
# Client is up (armed or not): report client_only before the watcher (if
# any) can ever observe the game running -- see write_app_state's header
# comment. A launcher tile (watch_appid empty) writes this once and never
# writes a game_* state, since game_exit_watcher never runs for it.
write_app_state client_only
if [[ -n "$watch_appid" ]]; then
  game_exit_watcher &
  watcher_pid=$!
fi
# A non-zero/signal exit here (e.g. 143) after an already-clean shutdown
# relay is expected docker-stop signal-exit semantics, not a failure --
# intentional, left as-is.
if wait_for_exit "$client_pid"; then rc=0; else rc=$?; fi
# Game-exit-initiated shutdown is the success path (the user quit the game,
# not a crash or an external stop) -- exit 0 regardless of the signal-shaped
# exit status client_pid actually returned.
if [[ "$game_exit_confirmed" == "1" ]]; then
  log "clean shutdown after game exit; exiting 0"
  rc=0
fi
exit "$rc"
