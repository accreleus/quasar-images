#!/usr/bin/env bash
set -euo pipefail

log() { printf '%s quasar-steam: %s\n' "$(date -Iseconds)" "$*" >&2; }

export STEAM_COMPAT_DATA_PATH="${STEAM_COMPAT_DATA_PATH:-$HOME/.local/share/quasar-steam/pfx}"
export WINEPREFIX="${WINEPREFIX:-$STEAM_COMPAT_DATA_PATH}"

# Steam/Gamescope environment, mirrored from the games-on-whales steam app
# (apps/steam/build-fedora/scripts/startup.sh) — the validated reference:
#   - keep games running when the nested Gamescope window loses focus
#   - let Steam drive Gamescope's fancy (integer/FSR) scaling
#   - route Qt/GTK input methods through Steam's on-screen keyboard
#   - expose VRAM to Proton titles (dxgi from Wine, not the builtin)
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS="${SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS:-0}"
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT="${STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT:-1}"
export STEAM_GAMESCOPE_HDR_SUPPORTED="${STEAM_GAMESCOPE_HDR_SUPPORTED:-0}"
export QT_IM_MODULE="${QT_IM_MODULE:-steam}"
export GTK_IM_MODULE="${GTK_IM_MODULE:-Steam}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-dxgi=n}"

# --- Steam UI mode & the game-foreground handoff -----------------------------
# In nested Gamescope, pressing "Play" only brings the game to the foreground if
# Gamescope can focus the game's window. Gamescope's Steam-integration focus is
# X11-atom driven (STEAM_GAME per-window appID + GAMESCOPECTRL_BASELAYER_APPID on
# the root window), and is independent of whether Steam is a child of Gamescope
# (games-on-whales and Valve's own gamescope-session both launch Steam as a
# sibling X client). Two validated configurations exist:
#
#   bigpicture  (default) - legacy Big Picture, `-bigpicture`. Steam does NOT pin
#               GAMESCOPECTRL_BASELAYER_APPID, so Gamescope's default focus raises
#               the newest STEAM_GAME-tagged window (the launched game). This is
#               the games-on-whales-validated path and the robust default here.
#   gamepadui   - modern Deck UI. Requires Steam to run in a full SteamOS session
#               (`-gamepadui -steamos3 -steampal -steamdeck` + STEAM_MULTIPLE_XWAYLANDS=1)
#               so Steam tags game windows and manages the baselayer handoff.
#               A PARTIAL gamepadui config (e.g. `-gamepadui` alone) pins focus to
#               the Steam UI forever and never releases it to launched games -
#               this is the defect this image fixes, so the flags ship as a
#               validated unit, never partially.
#
# STEAM_STARTUP_FLAGS overrides the computed flags verbatim (advanced use).
ui_mode="${QUASAR_STEAM_UI_MODE:-bigpicture}"
case "$ui_mode" in
  bigpicture)
    default_flags="-bigpicture"
    multi_xwayland_default=0
    ;;
  gamepadui)
    default_flags="-gamepadui -steamos3 -steampal -steamdeck"
    multi_xwayland_default=1
    ;;
  *)
    log "unknown QUASAR_STEAM_UI_MODE='$ui_mode'; falling back to bigpicture"
    default_flags="-bigpicture"
    multi_xwayland_default=0
    ;;
esac
export STEAM_STARTUP_FLAGS="${STEAM_STARTUP_FLAGS:-$default_flags}"

# Per-game Xwayland isolation is part of the validated gamepadui unit and stays
# off for bigpicture. Gamescope composites every Xwayland into one output, so the
# node-agent's compositor capture is unaffected either way.
if [[ "${QUASAR_STEAM_MULTIPLE_XWAYLANDS:-$multi_xwayland_default}" == "1" ]]; then
  export STEAM_MULTIPLE_XWAYLANDS=1
fi

# --- Launch requirement diagnostics (non-fatal) ------------------------------
# Steam's Chromium command buffers need a large /dev/shm; Docker's 64 MB default
# yields a black/flashing UI. The image cannot raise this - the launcher must be
# run with `--shm-size=1g` (or equivalent). Warn loudly if it looks too small.
shm_kb="$(df -Pk /dev/shm 2>/dev/null | awk 'NR==2{print $2}' || true)"
if [[ "$shm_kb" =~ ^[0-9]+$ && "$shm_kb" -lt 262144 ]]; then
  log "WARNING: /dev/shm is only $((shm_kb / 1024)) MiB; Steam needs >=1 GiB (run with --shm-size=1g)."
fi

# 32-bit Steam and games need 32-bit GL/Vulkan userspace. The image deliberately
# does not bake NVIDIA driver libs (they are driver-version coupled); the host's
# container runtime must inject the 32-bit driver libs (NVIDIA_DRIVER_CAPABILITIES
# including graphics+compat32). Warn if NVIDIA 64-bit GL is present but 32-bit is not.
if [[ -e /usr/lib64/libGLX_nvidia.so.0 ]] \
   && ! { ldconfig -p 2>/dev/null | grep -F 'libGLX_nvidia.so.0 (libc6)' | grep -qv 'x86-64'; }; then
  log "WARNING: 64-bit NVIDIA GL present but 32-bit libGLX_nvidia.so.0 was not injected;"
  log "         32-bit Steam/games will fail. See images/quasar-steam/README.md (host requirements)."
fi

client=(dbus-run-session -- /usr/local/bin/quasar-steam-client "$@")

if [[ "${QUASAR_STEAM_GAMESCOPE:-1}" != "1" ]]; then
  exec "${client[@]}"
fi

# --- Gamescope launch: GOW-pattern ready-socket handshake --------------------
# Mirrors games-on-whales apps/steam startup.sh (the validated-working input
# path). Key structural points, each load-bearing:
#   1. Gamescope runs WITHOUT a client argument; Steam is started as a SIBLING
#      afterwards. Passing Steam as gamescope''s child arg left it mis-wired
#      (no DISPLAY / outer WAYLAND_DISPLAY) and input never reached it.
#   2. `-R socket`: gamescope reports its actual X display + nested Wayland
#      socket through the ready socket; we export exactly what it reports
#      instead of guessing ":0".
#   3. ibus-daemon is started (QT_IM_MODULE=steam needs it; without the daemon
#      the Steam IME can eat keyboard input).
export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1
gs_tmpdir=$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" -d -t gamescope.XXXXXXX)
gs_socket="$gs_tmpdir/startup.socket"
gs_stats="$gs_tmpdir/stats.pipe"
mkfifo -- "$gs_stats"
mkfifo -- "$gs_socket"

log "starting Gamescope (mode=$ui_mode flags='$STEAM_STARTUP_FLAGS' multi_xwayland=${STEAM_MULTIPLE_XWAYLANDS:-0})"
gamescope -e ${GAMESCOPE_MODE:--b} -R "$gs_socket" -T "$gs_stats" \
  -W "${GAMESCOPE_WIDTH:-1920}" \
  -H "${GAMESCOPE_HEIGHT:-1080}" \
  -r "${GAMESCOPE_REFRESH:-60}" &

if read -r -t 5 gs_x_display gs_wl_display <> "$gs_socket"; then
  export DISPLAY="$gs_x_display"
  export GAMESCOPE_WAYLAND_DISPLAY="$gs_wl_display"
  unset WAYLAND_DISPLAY
  log "gamescope ready: DISPLAY=$DISPLAY nested_wayland=$gs_wl_display"
else
  log "FATAL: gamescope did not report ready within 5s"
  exit 1
fi

if command -v ibus-daemon >/dev/null 2>&1; then
  ibus-daemon -d -r --panel=disable --emoji-extension=disable || log "WARN: ibus-daemon failed to start"
fi

exec "${client[@]}"
