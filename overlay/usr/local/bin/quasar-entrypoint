#!/usr/bin/env bash
set -euo pipefail

log() { printf '%s quasar-base: %s\n' "$(date -Iseconds)" "$*" >&2; }
fail() { log "ERROR: $*"; exit 64; }

: "${PUID:=1000}" "${PGID:=1000}" "${UNAME:=quasar}" "${HOME:=/home/quasar}" "${UMASK:=022}"
[[ "$PUID" =~ ^[0-9]+$ && "$PGID" =~ ^[0-9]+$ ]] || fail "PUID and PGID must be numeric"
[[ "$UNAME" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || fail "UNAME is not a valid Linux user name"
[[ "$UMASK" =~ ^0?[0-7]{3}$ ]] || fail "UMASK must be an octal value such as 022"

if [[ "$(id -u)" == "0" ]]; then
  if ! getent group "$PGID" >/dev/null; then
    group_name="$UNAME"
    if getent group "$group_name" >/dev/null; then
      group_name="${UNAME}-${PGID}"
    fi
    groupadd --gid "$PGID" "$group_name"
  fi
  if ! getent passwd "$PUID" >/dev/null; then
    user_name="$UNAME"
    if getent passwd "$user_name" >/dev/null; then
      user_name="${UNAME}-${PUID}"
    fi
    useradd --no-log-init --uid "$PUID" --gid "$PGID" --home-dir "$HOME" --create-home --shell /bin/bash "$user_name"
  fi

  export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
  export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
  export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/quasar-runtime-$PUID}"
  install -d -o "$PUID" -g "$PGID" -m 0750 "$HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME"
  install -d -o "$PUID" -g "$PGID" -m 0700 "$XDG_RUNTIME_DIR"
  umask "$UMASK"

  for hook in /etc/quasar/init.d/*.sh; do
    [[ -x "$hook" ]] || continue
    log "running init hook $(basename "$hook")"
    "$hook"
  done

  if [[ -x /usr/local/bin/quasar-gpu-init ]]; then
    /usr/local/bin/quasar-gpu-init
  fi
  if [[ -x /usr/local/bin/quasar-gpu-probe && "${QUASAR_GPU_PROBE_ON_STARTUP:-1}" == "1" ]]; then
    /usr/local/bin/quasar-gpu-probe
  fi

  printf '{"event":"quasar-base.ready","uid":%s,"gid":%s,"home":"%s"}\n' "$PUID" "$PGID" "$HOME" >&2
  exec setpriv --reuid="$PUID" --regid="$PGID" --init-groups --inh-caps=-all -- "$@"
fi

exec "$@"
