#!/usr/bin/env bash
set -euo pipefail

log() { printf '%s quasar-base: %s\n' "$(date -Iseconds)" "$*" >&2; }
fail() { log "ERROR: $*"; exit 64; }

: "${PUID:=1000}" "${PGID:=1000}" "${UNAME:=quasar}" "${HOME:=/home/quasar}" "${UMASK:=022}"
[[ "$PUID" =~ ^[0-9]+$ && "$PGID" =~ ^[0-9]+$ ]] || fail "PUID and PGID must be numeric"
[[ "$UNAME" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || fail "UNAME is not a valid Linux user name"
[[ "$UMASK" =~ ^0?[0-7]{3}$ ]] || fail "UMASK must be an octal value such as 022"

if [[ "$(id -u)" == "0" ]]; then
  if ! getent group "$PGID" >/dev/null; then
    group_name="$UNAME"
    if getent group "$group_name" >/dev/null; then
      group_name="${UNAME}-${PGID}"
    fi
    groupadd --gid "$PGID" "$group_name"
  fi
  if ! getent passwd "$PUID" >/dev/null; then
    user_name="$UNAME"
    if getent passwd "$user_name" >/dev/null; then
      user_name="${UNAME}-${PUID}"
    fi
    useradd --no-log-init --uid "$PUID" --gid "$PGID" --home-dir "$HOME" --create-home --shell /bin/bash "$user_name"
  fi

  export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
  export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
  export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/quasar-runtime-$PUID}"

  # `install -d` only chowns the directories it is EXPLICITLY told to create —
  # an intermediate parent it creates implicitly along the way (e.g. ~/.local
  # when creating ~/.local/share, since only .local/share is named) is left
  # root-owned. Walk each target path under $HOME level by level so every
  # directory it passes through is created+chowned, not just the leaf.
  own_dir_chain() {
    local target="$1" rel part path="$HOME"
    install -d -o "$PUID" -g "$PGID" -m 0750 "$HOME"
    if [[ "$target" == "$HOME" ]]; then
      return
    fi
    rel="${target#"$HOME"/}"
    if [[ "$rel" == "$target" ]]; then
      # target is not under $HOME — nothing implicit to walk; just create it.
      install -d -o "$PUID" -g "$PGID" -m 0750 "$target"
      return
    fi
    while [[ -n "$rel" ]]; do
      part="${rel%%/*}"
      path="$path/$part"
      install -d -o "$PUID" -g "$PGID" -m 0750 "$path"
      if [[ "$rel" == "$part" ]]; then
        rel=""
      else
        rel="${rel#"$part"/}"
      fi
    done
  }

  for d in "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME"; do
    own_dir_chain "$d"
  done
  install -d -o "$PUID" -g "$PGID" -m 0700 "$XDG_RUNTIME_DIR"
  umask "$UMASK"

  for hook in /etc/quasar/init.d/*.sh; do
    [[ -x "$hook" ]] || continue
    log "running init hook $(basename "$hook")"
    "$hook"
  done

  if [[ -x /usr/local/bin/quasar-gpu-init ]]; then
    /usr/local/bin/quasar-gpu-init
  fi
  # The probe runs AS THE APPLICATION USER, not as root. As root it answered a
  # question nobody asked: root has CAP_DAC_OVERRIDE and opens a 0660 DRM node
  # whatever its group is, so the probe passed on hosts where the app user could
  # not open /dev/dri at all and the session then software-rendered (or, under
  # gamescope, aborted on the missing VK_EXT_physical_device_drm). Dropping the
  # same way the real command does — after the init hooks, so it also proves
  # 10-dri-device-groups.sh did its job — makes the contract check observe what
  # the application will observe.
  if [[ -x /usr/local/bin/quasar-gpu-probe && "${QUASAR_GPU_PROBE_ON_STARTUP:-1}" == "1" ]]; then
    setpriv --reuid="$PUID" --regid="$PGID" --init-groups -- /usr/local/bin/quasar-gpu-probe
  fi

  printf '{"event":"quasar-base.ready","uid":%s,"gid":%s,"home":"%s"}\n' "$PUID" "$PGID" "$HOME" >&2

  # Grant CAP_SYS_NICE as an AMBIENT capability across the uid/gid drop so
  # gamescope can raise its compute-thread priority (otherwise it logs
  # "No CAP_SYS_NICE, falling back to regular-priority compute"). setpriv
  # requires an ambient cap to also be inheritable, hence both flags below.
  # This is CONDITIONAL on the container's bounding set actually holding
  # cap_sys_nice — older node-agents that don't `--cap-add SYS_NICE` won't
  # have it in CapBnd, and passing --ambient-caps for a cap outside the
  # bounding set makes setpriv fail outright, so we must not do it unconditionally.
  inh_caps="-all"
  ambient_args=()
  capbnd="$(awk '/^CapBnd:/ {print $2}' /proc/self/status 2>/dev/null || true)"
  if [[ "$capbnd" =~ ^[0-9a-fA-F]+$ ]] && (( (0x$capbnd >> 23) & 1 )); then
    inh_caps="-all,+sys_nice"
    ambient_args=(--ambient-caps=+sys_nice)
  fi
  exec setpriv --reuid="$PUID" --regid="$PGID" --init-groups "${ambient_args[@]}" --inh-caps="$inh_caps" -- "$@"
fi

exec "$@"
