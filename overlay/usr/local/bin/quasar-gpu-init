#!/usr/bin/env bash
set -euo pipefail

log() { printf '%s quasar-gpu-init: %s\n' "$(date -Iseconds)" "$*" >&2; }

# The NVIDIA Container Toolkit mounts a driver-matched userspace stack. Refresh
# its linker cache without replacing runtime-provided ICD or GLVND metadata.
if [[ -d /usr/local/nvidia/lib64 || -d /usr/local/nvidia/lib ]]; then
  log "detected injected NVIDIA userspace; refreshing linker cache"
  ldconfig
fi

for hook in /etc/quasar/gpu.d/*; do
  [[ -x "$hook" ]] || continue
  log "running GPU hook $(basename "$hook")"
  "$hook"
done

