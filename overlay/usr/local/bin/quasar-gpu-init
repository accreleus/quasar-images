#!/usr/bin/env bash
set -euo pipefail

log() { printf '%s quasar-gpu-init: %s\n' "$(date -Iseconds)" "$*" >&2; }

# Register the NVIDIA userspace the host's container runtime injects at launch,
# so the image never bakes (driver-version-coupled) driver libraries. Mirrors
# games-on-whales images/base/build-fedora/overlay/etc/cont-init.d/30-nvidia.sh.
#
# Two injection shapes are supported:
#   1. A mounted driver volume at /usr/nvidia (Wolf-style): copy its ICD/EGL/gbm
#      descriptors into the system search paths.
#   2. The nvidia-container-toolkit (detected by libnvidia-allocator.so.1): the
#      libraries land on the linker path already; we only (re)create the JSON
#      loader descriptors and the gbm backend symlink if the toolkit did not.
#
# Either way `ldconfig` must run so freshly-injected libs — including the 32-bit
# (compat32) set Steam/Proton need — resolve. The toolkit must be configured to
# inject 32-bit libs (NVIDIA_DRIVER_CAPABILITIES incl. graphics+compat32); this
# script registers whatever it injected but cannot conjure a missing arch.
#
# Separately (issue #375), on hosts where the toolkit's CDI spec has no 32-bit
# refs at all (verified on unraid/nvidia-driver.plg), the node-agent additively
# bind-mounts just the host's 32-bit NVIDIA userspace read-only at
# /opt/quasar/nvidia-lib32 so native (non-Proton) 32-bit titles can resolve
# libGLX_nvidia.so.0 etc. The image ships an /etc/ld.so.conf.d entry pointing
# at that path (never bakes the libs); nvidia_32bit_volume() below re-runs
# ldconfig and logs when the mount is present. This runs independently of, and
# after, whichever of nvidia_volume/nvidia_toolkit matched below, so it
# doesn't fight the 64-bit toolkit injection into the standard system paths.

nvidia_volume() {
  # Require the share/ subtree, not just a bare /usr/nvidia dir, so only a
  # real full GOW driver volume matches here. (The issue #375 32-bit-only
  # mount now lives at /opt/quasar/nvidia-lib32 and never touches /usr/nvidia
  # — it used to bind at /usr/nvidia/lib, which also broke upstream GOW
  # images whose cont-init treats a present /usr/nvidia as a full volume.)
  [[ -d /usr/nvidia/share ]] || return 1
  log "NVIDIA driver volume detected at /usr/nvidia"
  ldconfig
  local src dst
  for pair in \
    "/usr/nvidia/share/vulkan/icd.d:/usr/share/vulkan/icd.d" \
    "/usr/nvidia/share/egl/egl_external_platform.d:/usr/share/egl/egl_external_platform.d" \
    "/usr/nvidia/share/glvnd/egl_vendor.d:/usr/share/glvnd/egl_vendor.d"; do
    src="${pair%%:*}"; dst="${pair##*:}"
    if [[ -d "$src" ]]; then
      mkdir -p "$dst" && cp -f "$src"/* "$dst"/ 2>/dev/null || true
    fi
  done
  if [[ -d /usr/nvidia/lib/gbm ]]; then
    mkdir -p /usr/lib64/gbm && cp -f /usr/nvidia/lib/gbm/* /usr/lib64/gbm/ 2>/dev/null || true
  fi
}

nvidia_toolkit() {
  [[ -e /usr/lib64/libnvidia-allocator.so.1 || -d /usr/local/nvidia/lib64 || -d /usr/local/nvidia/lib ]] || return 1
  log "NVIDIA container-toolkit userspace detected; registering loaders"
  ldconfig

  if [[ ! -e /usr/lib64/gbm/nvidia-drm_gbm.so && -e /usr/lib64/libnvidia-allocator.so.1 ]]; then
    mkdir -p /usr/lib64/gbm
    ln -sf ../libnvidia-allocator.so.1 /usr/lib64/gbm/nvidia-drm_gbm.so
  fi

  if [[ ! -f /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]]; then
    mkdir -p /usr/share/glvnd/egl_vendor.d
    printf '{\n  "file_format_version": "1.0.0",\n  "ICD": { "library_path": "libEGL_nvidia.so.0" }\n}\n' \
      > /usr/share/glvnd/egl_vendor.d/10_nvidia.json
  fi
  if [[ ! -f /usr/share/vulkan/icd.d/nvidia_icd.json ]]; then
    mkdir -p /usr/share/vulkan/icd.d
    printf '{\n  "file_format_version": "1.0.0",\n  "ICD": { "library_path": "libGLX_nvidia.so.0", "api_version": "1.3.242" }\n}\n' \
      > /usr/share/vulkan/icd.d/nvidia_icd.json
  fi
  if [[ ! -f /usr/share/egl/egl_external_platform.d/10_nvidia_wayland.json ]]; then
    mkdir -p /usr/share/egl/egl_external_platform.d
    printf '{\n  "file_format_version": "1.0.0",\n  "ICD": { "library_path": "libnvidia-egl-wayland.so.1" }\n}\n' \
      > /usr/share/egl/egl_external_platform.d/10_nvidia_wayland.json
  fi
}

# Quasar-provisioned driver volume (first-run S1) mounted at
# /opt/quasar/nvidia-driver — the THIRD injection shape, alongside the GOW
# /usr/nvidia volume and the container toolkit. The node-agent injects EGL and
# Vulkan discovery for it by environment, so only GBM needs help here: Mesa's
# libgbm finds backends by scanning a compile-time directory (/usr/lib64/gbm),
# and no environment variable was pointing it at the volume's copy.
#
# WHY THIS MATTERS (quasar-images#4 follow-on, root-caused live 2026-08-09):
# without it, Vulkan worked — gamescope selected the RTX 5090 and reported DRM
# format modifiers, so the session looked healthy — while everything routed
# through gbm_create_device() fell back to Mesa, which has no driver for
# nvidia-drm:
#
#   pci id for fd 5: 10de:2b85, driver (null)
#   Refusing to try glamor on llvmpipe
#   XWAYLAND: Disabling GLAMOR support
#   libEGL warning: failed to open /dev/dri/card1: Permission denied
#
# A software-rendered Xwayland advertises no DRI3, so Steam's CEF GPU process
# failed init in a loop and steamwebhelper's X window churned — the Big Picture
# logo flickered and never painted a sign-in screen.
#
# The `card1: Permission denied` line is a SYMPTOM, not the cause: it is Mesa
# reaching for the primary node as a last resort. Once libgbm loads NVIDIA's
# backend nothing wants that node and the message disappears. Do NOT "fix" it
# by adding the app user to the `video` group or chmod'ing the device — that
# grants privilege to paper over a discovery bug and still leaves Mesa driving
# an NVIDIA node.
#
# The durable fix is agent-side (GBM_BACKENDS_PATH in the node-agent's
# app-container args), because it reaches third-party images that will never
# carry this script. This branch is the image-side belt: no agent rebuild
# needed, and it also covers a bare `docker run` with the volume mounted. When
# the agent sets the env var it wins (GBM_BACKENDS_PATH REPLACES the search
# directory) and this symlink simply goes unused — harmless by construction.
nvidia_quasar_volume() {
  local backend=/opt/quasar/nvidia-driver/gbm/nvidia-drm_gbm.so
  # Absent on a host with its own driver and on every non-NVIDIA host. Never
  # create a dangling symlink: libgbm would find the name, fail to dlopen it,
  # and that is strictly worse than an empty directory.
  [[ -f "$backend" ]] || return 0
  # A WORKING backend already published by the toolkit branch above (or baked
  # into the image) wins — clobbering another driver integration is not our
  # business. `-e` follows symlinks, so this skips a valid symlink and replaces
  # a dangling one, which is exactly the wanted behaviour.
  if [[ -e /usr/lib64/gbm/nvidia-drm_gbm.so ]]; then
    return 0
  fi
  if mkdir -p /usr/lib64/gbm && ln -sfn "$backend" /usr/lib64/gbm/nvidia-drm_gbm.so; then
    log "Quasar NVIDIA driver volume: published GBM backend at /usr/lib64/gbm/nvidia-drm_gbm.so"
  else
    log "WARNING: could not publish the GBM backend; Xwayland will software-render"
    log "         unless the node-agent sets GBM_BACKENDS_PATH"
  fi
  return 0
}

# 32-bit-only additive driver volume (issue #375): independent of, and safe to
# run alongside, either branch above — ldconfig's class-based matching means a
# 32-bit-only search path here never shadows the 64-bit libs the toolkit or
# the full driver-volume path just registered.
nvidia_32bit_volume() {
  local dir=/opt/quasar/nvidia-lib32
  local count
  # find exits 1 when $dir is absent; under `set -o pipefail` that fails the
  # whole assignment and errexit kills the script — default to 0 instead.
  count=$(find "$dir" -maxdepth 1 -type f 2>/dev/null | wc -l) || count=0
  if [[ "$count" -gt 0 ]]; then
    ldconfig
    log "32-bit NVIDIA driver volume detected at $dir ($count libs), ldconfig refreshed"
  fi
  # Absence is the normal AMD/no-32-bit-support case, not an error — stay silent.
  return 0
}

nvidia_volume || nvidia_toolkit || true
# Runs AFTER the branches above so a backend either of them published wins, and
# unconditionally (not chained with ||) because the Quasar volume coexists with
# the toolkit: the agent passes --gpus all for CUDA while the volume supplies
# the GL/EGL/Vulkan/GBM userspace the toolkit's CUDA-only injection omits.
nvidia_quasar_volume
nvidia_32bit_volume
