#!/usr/bin/env bash
# Test stub for wireplumber: records that it started, with the runtime dir and bus it
# was given.
set -euo pipefail
log="${STUB_LOG:?STUB_LOG must name the case log directory}"
printf '%s XDG_RUNTIME_DIR=%s DBUS_SESSION_BUS_ADDRESS=%s\n' wireplumber "${XDG_RUNTIME_DIR:-<unset>}" "${DBUS_SESSION_BUS_ADDRESS:-<unset>}" >> "$log/audio.log"

exit 0
